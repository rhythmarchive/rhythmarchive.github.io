---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardSkeleton from "../../components/CardSkeleton.astro";
import BatchTray from "../../components/BatchTray.astro";
import { getPublicNavigationGames } from "../../lib/site-data";
import { urls } from "../../lib/site-urls";
import "../../styles/local-library.css";

const categories = getPublicNavigationGames().flatMap((game) => game.categories.map((category) => `${game.slug}/${category.slug}`));
---
<BaseLayout title="收藏与历史 | Rhythm Archive" description="在 Rhythm Archive 查看收藏的音游曲绘与图片资源，继续浏览最近打开的资源详情。收藏与浏览历史保存在当前浏览器，方便再次查找作品、预览图片和下载原图。" canonicalPath="/library/" bodyClass="library-page">
  <section class="page-container gallery-shell library-shell" data-library-root data-categories={JSON.stringify(categories)}>
    <div class="page-heading library-heading">
      <span class="archive-kicker">Rhythm Archive</span>
      <h1>收藏与历史</h1>
      <p>收藏喜欢的资源，看过的详情页会自动记到“最近浏览”里。</p>
    </div>
    <div class="variant-tabs library-tabs" role="tablist" aria-label="本地资源列表">
      <button type="button" role="tab" id="favorites-tab" data-library-tab="favorites" aria-controls="library-panel" aria-selected="true"><span>收藏夹</span><span class="library-tab-count" data-library-tab-count>0</span></button>
      <button type="button" role="tab" id="history-tab" data-library-tab="history" aria-controls="library-panel" aria-selected="false" tabindex="-1"><span>最近浏览</span><span class="library-tab-count" data-library-tab-count>0</span></button>
    </div>
    <p class="detail-note" data-library-warning role="status"></p>
    <div id="library-panel" role="tabpanel" aria-labelledby="favorites-tab" tabindex="0">
      <div class="gallery-toolbar">
        <span data-library-count aria-live="polite"></span>
        <div class="gallery-toolbar-actions">
          <button type="button" class="text-link" data-library-retry hidden>重试</button>
          <button type="button" class="text-link" data-history-tools-toggle aria-expanded="false" aria-controls="library-history-tools" hidden>批量删除</button>
          <button type="button" class="text-link" data-clear-history hidden>清空历史</button>
        </div>
      </div>
      <form id="library-history-tools" class="library-history-tools" data-history-tools aria-label="批量删除浏览记录" hidden>
        <div class="library-history-fields">
          <label class="filter-control"><span>删除此日期之前的记录</span><input type="date" data-history-before aria-describedby="library-history-note" /></label>
          <label class="filter-control"><span>游戏</span><select data-history-game><option value="">全部游戏</option></select></label>
        </div>
        <p class="detail-note" id="library-history-note">不含所选日期当天；同时选择日期和游戏时，只删除符合两项条件的记录。收藏夹不受影响。</p>
        <p class="detail-note" data-history-match role="status"></p>
        <div class="library-history-actions">
          <button type="button" class="button button-secondary" data-history-tools-close>取消</button>
          <button type="submit" class="button button-primary" data-history-delete disabled>删除记录</button>
        </div>
      </form>
      <div class="search-empty" data-library-empty hidden>
        <p data-library-empty-copy></p>
        <button class="button button-secondary" type="button" data-library-view-history hidden>查看最近浏览</button>
        <a class="button button-secondary" data-library-empty-games href={urls.sitePath("/games/")}>浏览游戏库</a>
      </div>
      <div class="gallery-grid" data-library-grid></div>
      <div data-library-loading hidden><CardSkeleton /></div>
      <div class="gallery-more"><button class="button button-secondary" type="button" data-library-more hidden>加载更多</button></div>
    </div>
    <details class="library-storage-note">
      <summary>本地保存说明</summary>
      <p>收藏与最近浏览仅保存在当前浏览器，清除网站数据后会丢失。最近浏览保留最近 90 天的 200 项资源。</p>
    </details>
    <BatchTray />
    <noscript><p>请启用 JavaScript 以查看本地收藏和浏览历史。</p></noscript>
  </section>
  <script src="../../scripts/local-library-page.ts"></script>
</BaseLayout>
