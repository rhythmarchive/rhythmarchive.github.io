---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArcaeaStoryAtlas from "../../../components/ArcaeaStoryAtlas.astro";
import BrowseGallery from "../../../components/BrowseGallery.astro";
import Gallery from "../../../components/Gallery.astro";
import type { GameId, ResourceTypeId } from "../../../lib/game-config";
import { getCategoryBrowseConfig } from "../../../lib/category-browse";
import GalleryHeading from "../../../components/GalleryHeading.astro";

import { getBrowseGalleryBuild, getPublicNavigationGames, getSiteData, loadCategoryBrowseProjections } from "../../../lib/site-data";
import { urls } from "../../../lib/site-urls";
import VideoGallery from "../../../components/VideoGallery.astro";

export function getStaticPaths() {
  const siteData = getSiteData();
  const navigationGames = getPublicNavigationGames();
  const browseBuild = getBrowseGalleryBuild();
  const categoryBrowse = loadCategoryBrowseProjections();
  const browseByGame: Partial<Record<GameId, typeof browseBuild.arcaea>> = { arcaea: browseBuild.arcaea, phigros: browseBuild.phigros, rizline: browseBuild.rizline, infalsus: browseBuild.infalsus };
  return navigationGames.flatMap((game) => game.categories.map((category) => ({
    params: { game: game.slug, category: category.slug },
    props: {
      game,
      category,
      resources: siteData.galleries[`${game.slug}/${category.slug}`] ?? [],
      browseData: category.slug === "jacket" ? browseByGame[game.slug] : undefined,
      storyStructure: game.slug === "arcaea" && category.slug === "story-cg" ? categoryBrowse.arcaea.storyStructure : undefined,
      storyAtlas: game.slug === "arcaea" && category.slug === "story-cg" ? categoryBrowse.arcaea.storyAtlas : undefined,
      storyUi: game.slug === "arcaea" && category.slug === "story-cg" ? siteData.storyUi.arcaea : undefined,
      storyAvatars: game.slug === "arcaea" && category.slug === "story-cg" ? siteData.resources.filter((resource) => resource.game === "arcaea" && resource.resourceType === "character-avatar") : undefined,
    },
  })));
}

const { game, category, resources, browseData, storyStructure, storyAtlas, storyUi, storyAvatars } = Astro.props;
const gameId = game.slug as GameId;
const categoryId = category.slug as ResourceTypeId;
const browseConfig = getCategoryBrowseConfig(gameId, categoryId, resources);
const firstImage = browseData?.items.find((item) => item.preview.large)?.preview.large?.url ?? resources.find((resource) => resource.preview.large)?.preview.large?.url;
const categoryCount = browseData?.items.length ?? category.count;
const description = `浏览并下载 ${game.displayName} ${category.label}${categoryId === "video" ? "视频" : "图片"}资源。`;
---

<BaseLayout title={`${game.displayName} ${category.label} | Rhythm Archive`} description={description} canonicalPath={`/${game.slug}/${category.slug}/`} ogImage={firstImage} bodyClass="gallery-page">
  {storyStructure || categoryId === "video" ? <GalleryHeading game={game} category={category} count={categoryCount} standalone /> : null}
  <div class="page-container">
    {categoryId === "video" ? <VideoGallery resources={resources} /> : browseData ? (
      <BrowseGallery data={browseData} categoryLabel={category.label} galleryUrl={urls.sitePath(`/data/browse/${game.slug}/jacket.json`)}>
        <GalleryHeading slot="heading" game={game} category={category} count={categoryCount} />
      </BrowseGallery>
    ) : (
      <>
        {storyStructure ? <ArcaeaStoryAtlas resources={resources} storyStructure={storyStructure} {...(storyAtlas ? { storyAtlas } : {})} {...(storyUi ? { storyUi } : {})} {...(storyAvatars ? { storyAvatars } : {})} /> : null}
        <Gallery resources={storyStructure ? [] : resources.slice(0, 48)} total={resources.length} game={gameId} category={categoryId} categoryLabel={category.label} galleryUrl={urls.sitePath(`/data/galleries/${game.slug}/${category.slug}.json`)} config={browseConfig} {...(storyStructure ? { defer: true } : {})}>
          {!storyStructure ? <GalleryHeading slot="heading" game={game} category={category} count={categoryCount} /> : null}
        </Gallery>
      </>
    )}
  </div>
</BaseLayout>
