---

import { getPublicNavigationGames } from "../../lib/site-data";
import { primaryCategorySlug } from "../../lib/game-config";
import { urls } from "../../lib/site-urls";

export function getStaticPaths() {

  return getPublicNavigationGames().map((game) => ({
    params: { game: game.slug },
    props: { redirectTo: urls.sitePath(`/${game.slug}/${primaryCategorySlug(game.slug)}/`) },
  }));
}

return Astro.redirect(Astro.props.redirectTo, 301);
---
