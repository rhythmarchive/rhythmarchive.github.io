---
import { BASE_PATH, ROS_BASE_URL } from "../../lib/site-config";
import { getPublicNavigationGames } from "../../lib/site-data";
import { createUrlHelpers } from "../../lib/url";

export function getStaticPaths() {
  const urls = createUrlHelpers({ basePath: BASE_PATH, origin: "https://rhythmarchive.github.io", rosBaseUrl: ROS_BASE_URL });
  return getPublicNavigationGames().map((game) => ({
    params: { game: game.slug },
    props: { redirectTo: urls.sitePath(`/${game.slug}/jacket/`) },
  }));
}

return Astro.redirect(Astro.props.redirectTo, 301);
---
