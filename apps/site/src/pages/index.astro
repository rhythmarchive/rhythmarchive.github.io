---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCard from "../components/GameCard.astro";
import GameIcon from "../components/GameIcon.astro";
import SearchBox from "../components/SearchBox.astro";
import RecentUpdates from "../components/RecentUpdates.astro";
import ResourceRanking from "../components/ResourceRanking.astro";
import { buildSearchQuickLinks } from "../lib/search-quick-links";
import { formatCount } from "../lib/format";
import { primaryCategorySlug } from "../lib/game-config";
import { BASE_PATH, PUBLIC_STATS_API_URL, ROS_BASE_URL } from "../lib/site-config";
import { getPublicNavigationGames, getSiteData } from "../lib/site-data";
import { urls } from "../lib/site-urls";

const siteData = getSiteData();
const games = getPublicNavigationGames();
const visibleGames = games.slice(0, 8);
const quickLinks = buildSearchQuickLinks({ games }).slice(0, 6);
const resourceCount = siteData.resources.length;
const homeOgImage = urls.absoluteUrl("/og/home.png");
const description = "Rhythm Archive 是音游曲绘、角色立绘与剧情 CG 下载站，收录 Arcaea、Phigros、Rizline、In Falsus 等游戏的图片资源。按游戏或分类查找作品，预览图片并下载原图，部分资源提供超分版。";
// Three falling lanes built from the local game icons. One loop holds six notes and
// is doubled, so the track always covers the (tall, tilted) lane without gaps.
const lanes = [0, 1, 2].map((lane) => {
  const picks = games.filter((_, index) => index % 3 === lane);
  const filled = picks.length >= 3 ? picks : [...picks, ...games.filter((game) => !picks.includes(game)).slice(lane, lane + 3 - picks.length)];
  const loop = [...filled, ...filled];
  return [...loop, ...loop];
});
const arcaeaApkManifestUrl = `${ROS_BASE_URL}/apk/arcaea/latest.json`;
---

<BaseLayout title="Rhythm Archive | 音游曲绘下载站" description={description} canonicalPath="/" ogImage={homeOgImage} bodyClass="home-page">
  <div data-site-base data-site-base-value={BASE_PATH}></div>

  <section class="page-container home-hero" aria-labelledby="home-heading">
    <div class="home-hero-content">
      <a class="home-apk-entry" href="#arcaea-apk">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path></svg>
        <span>Arcaea 安卓安装包</span>
        <strong data-apk-entry-version hidden></strong>
        <span class="home-apk-entry-arrow" aria-hidden="true">→</span>
      </a>
      <h1 id="home-heading">音游图片下载站</h1>
      <p class="home-hero-lead">收录音游曲绘、立绘、CG 等图片资源，原图与超分版都能直接下载。</p>
      <p class="home-stats" aria-label={`${formatCount(games.length)} 款游戏，${formatCount(resourceCount)} 项资源`}>
        <span class="home-stat"><strong>{formatCount(games.length)}</strong>款游戏</span>
        <span class="home-stat"><strong>{formatCount(resourceCount)}</strong>项资源</span>
        <span class="home-stats-runtime" data-site-stats data-stats-state="loading" hidden={!PUBLIC_STATS_API_URL} aria-live="polite" aria-busy="true" aria-label="访问统计加载中">
          <span class="home-stat"><strong data-site-total-visits>—</strong>累计来访</span>
          <span class="home-stat is-today"><strong data-site-today-visits>—</strong>今日来访</span>
        </span>
      </p>
      <div class="home-search-block">
        <SearchBox label="搜索音游图片资源" />
      </div>
      {quickLinks.length > 0 && (
        <div class="home-quick-links" aria-label="热门分类">
          <span>热门分类</span>
          {quickLinks.map((entry) => <a href={urls.sitePath(entry.href)}>{entry.label}<small>{formatCount(entry.count)}</small></a>)}
        </div>
      )}
    </div>
    <div class="home-hero-stage" aria-hidden="true">
      <div class="hero-highway">
        {lanes.map((lane, laneIndex) => (
          <div class="hero-lane" style={`--lane: ${laneIndex}`}>
            <div class="hero-lane-track">
              {/* Repeated decorative shortcuts; keyboard navigation uses the game cards below. */}
              {lane.map((game) => (
                <a class="hero-note" href={urls.sitePath(`/${game.slug}/${primaryCategorySlug(game.slug)}/`)} tabindex="-1" title={game.displayName}>
                  <GameIcon game={game.slug} eager />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="hero-judge-line"><span></span></div>
    </div>
  </section>

  <section class="page-container home-games" aria-labelledby="games-heading">
    <div class="section-heading">
      <div><span class="section-kicker">Games</span><h2 id="games-heading">收录游戏</h2></div>
      <a class="section-link" href={urls.sitePath("/games/")}>全部游戏{games.length > visibleGames.length ? ` · ${games.length}` : ""} <span aria-hidden="true">→</span></a>
    </div>
    <div class="game-card-grid">
      {visibleGames.map((game) => <GameCard game={game} />)}
    </div>
  </section>

  <section class="page-container home-apk" id="arcaea-apk" aria-labelledby="apk-heading" data-arcaea-apk-card data-manifest-url={arcaeaApkManifestUrl}>
    <div class="section-heading">
      <div><span class="section-kicker">Download</span><h2 id="apk-heading">Arcaea APK 下载</h2></div>
      <span class="section-heading-note">版本信息来自官网首页</span>
    </div>
    <div class="apk-card">
      <span class="apk-card-icon"><GameIcon game="arcaea" /></span>
      <div class="apk-card-state" data-arcaea-apk-state aria-busy="true">
        <div class="apk-card-main" aria-hidden="true">
          <div class="apk-card-identity"><span class="apk-card-product">Arcaea · Android</span><strong class="async-placeholder">0.0.0</strong><span class="apk-version-tag">最新版本</span></div>
          <dl class="apk-card-meta"><div><dt>文件大小</dt><dd class="async-placeholder">0.00 GB</dd></div><div><dt>更新时间</dt><dd class="async-placeholder">2026年10月16日 00:00</dd></div></dl>
        </div>
        <div class="apk-download-actions" aria-hidden="true"><span class="button apk-official-button async-placeholder">历史版本</span><span class="button apk-download-button async-placeholder">下载 APK</span></div>
        <span class="sr-only">正在获取版本信息…</span>
      </div>
    </div>
  </section>

  <RecentUpdates />

  <ResourceRanking compact limit={6} headingId="home-ranking-heading" />
  <script src="../scripts/apk-card.ts"></script>
</BaseLayout>
