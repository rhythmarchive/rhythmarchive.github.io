---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameIcon from "../components/GameIcon.astro";
import SearchBox from "../components/SearchBox.astro";
import { formatCount } from "../lib/format";
import { BASE_PATH, ROS_BASE_URL } from "../lib/site-config";
import { getSiteData } from "../lib/site-data";
import { createUrlHelpers } from "../lib/url";

const data = getSiteData();
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: "https://rhythmarchive.github.io", rosBaseUrl: ROS_BASE_URL });
const games = data.games;
const homeImage = data.resources.find((resource) => resource.preview.medium)?.preview.medium?.url;
const description = "浏览并下载 Arcaea、Phigros 的曲绘、角色立绘、剧情 CG 与其他游戏图片资源。";
const arcaeaApkManifestUrl = `${ROS_BASE_URL}/apk/arcaea/latest.json`;
---

<BaseLayout title="Rhythm Archive | Arcaea / Phigros 图片资源下载站" description={description} canonicalPath="/" ogImage={homeImage} bodyClass="home-page">
  <div data-site-base data-site-base-value={BASE_PATH}></div>
  <section class="home-intro page-container">
    <div class="home-intro-copy">
      <span class="archive-kicker">Rhythm Archive</span>
      <h1>找到下一张<br /><em>想保存的曲绘。</em></h1>
      <p>按游戏整理的 Arcaea、Phigros 图像资料。曲绘、角色、剧情与那些值得回看的画面，都在这里。</p>
    </div>
    <div class="home-search-block">
      <SearchBox />
      <span>试试搜索曲名、曲师或资源名称</span>
    </div>
  </section>

  <section class="page-container home-games" aria-labelledby="games-heading">
    <div class="section-heading">
      <div><h2 id="games-heading">从游戏开始</h2></div>
      <span class="section-heading-note">按游戏浏览全部资源</span>
    </div>
    <div class="game-entry-grid">
      {games.map((game) => {
        return (
          <a class={`game-entry-card game-${game.slug}`} href={urls.sitePath(`/${game.slug}/`)}>
            <div class="game-entry-image">
              <GameIcon game={game.slug} />
            </div>
            <div class="game-entry-copy">
              <div><h3>{game.displayName}</h3><span>{formatCount(game.count)} 项资源</span></div>
              <p>{game.slug === "arcaea" ? "曲绘 · 角色立绘 · 剧情 CG" : "曲绘 · 头像 · 曲包封面"}</p>
            </div>
            <span class="arrow-link" aria-hidden="true">↗</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="page-container home-categories" aria-labelledby="categories-heading">
    <div class="section-heading">
      <div><h2 id="categories-heading">主要资源分类</h2></div>
      <span class="section-heading-note">每个游戏各自整理</span>
    </div>
    <div class="home-category-groups">
      {games.map((game) => (
        <section class="home-category-group" aria-labelledby={`home-${game.slug}-categories`}>
          <div class="home-category-group-heading">
            <h3 id={`home-${game.slug}-categories`}>{game.displayName}</h3>
            <a href={urls.sitePath(`/${game.slug}/`)}>查看全部 <span aria-hidden="true">↗</span></a>
          </div>
          <div class="featured-category-grid">
            {game.featuredCategories.slice(0, 5).map((category) => (
              <a class="category-tile" href={urls.sitePath(`/${game.slug}/${category.slug}/`)}>
                <span class="category-tile-mark" aria-hidden="true"></span>
                <strong>{category.label}</strong>
                <span>{formatCount(category.count)} 项</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="page-container home-apk" aria-labelledby="apk-heading" data-arcaea-apk-card data-manifest-url={arcaeaApkManifestUrl}>
    <div class="section-heading"><div><span class="section-kicker">Download</span><h2 id="apk-heading">Arcaea APK</h2></div><span class="section-heading-note">GitHub Release · 官方 CDN</span></div>
    <div class="apk-card-state" data-arcaea-apk-state><span>正在读取最新版本…</span></div>
  </section>
  <script src="../scripts/apk-card.ts"></script>
</BaseLayout>
