---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardSkeleton from "../../components/CardSkeleton.astro";
import SearchBox from "../../components/SearchBox.astro";
import BatchTray from "../../components/BatchTray.astro";
import GalleryDownload from "../../components/GalleryDownload.astro";
import { formatCount } from "../../lib/format";
import { buildSearchQuickLinks } from "../../lib/search-quick-links";
import { getPublicNavigationGames } from "../../lib/site-data";
import { urls } from "../../lib/site-urls";
import { CATEGORY_LABELS } from "../../lib/game-config";

const query = Astro.url.searchParams.get("q") ?? "";
const description = "在 Rhythm Archive 搜索音游曲绘、角色立绘与剧情 CG，按作品名称、曲师和游戏筛选图片资源。找到对应曲绘后可进入详情预览，查看图片信息并选择下载原图或已有的超分版。";

const games = getPublicNavigationGames();
const quickLinks = buildSearchQuickLinks({ games });
const browseGroups = games.map((game) => ({
  ...game,
  categories: game.categories.filter((category) => category.count > 0),
})).filter((game) => game.categories.length > 0);
---

<BaseLayout title="搜索资源 | Rhythm Archive" description={description} canonicalPath="/search/" bodyClass="search-page">
  <section class="page-container search-page-head page-heading" data-search-head>
    <div class="search-head-copy">
      <span class="archive-kicker">Rhythm Archive</span>
      <h1>搜索资源</h1>
    </div>
    <SearchBox initialQuery={query} />
    <div class="search-filters">
      <label>游戏 <select data-search-game><option value="">全部游戏</option>{games.map((game) => <option value={game.slug} data-categories={game.categories.filter(category => category.count > 0).map(category => category.slug).join(",")}>{game.displayName}</option>)}</select></label>
      <label>分类 <select data-search-category><option value="">全部分类</option>{Object.entries(CATEGORY_LABELS).filter(([slug]) => games.some((game) => game.categories.some((category) => category.slug === slug))).map(([slug, label]) => <option value={slug}>{label}</option>)}</select></label>
      <label><span class="sr-only">排序</span><select data-search-sort><option value="relevance">相关度</option><option value="title-asc">名称 A-Z</option><option value="title-desc">名称 Z-A</option></select></label>
      <label class="filter-check"><input type="checkbox" data-search-upscaled />含超分版</label>
    </div>
    <p class="detail-note" data-search-filter-note hidden>所选游戏没有此分类。</p>
    <div class="search-quick-links" data-search-landing>
      <span>快捷入口</span>
      {quickLinks.map((entry) => <a href={urls.sitePath(entry.href)}>{entry.label}<small>{formatCount(entry.count)}</small></a>)}
    </div>
  </section>
  <section class="page-container search-landing-browse" data-search-landing>
    <div class="search-landing-browse-heading">
      <h2>按分类浏览</h2>
    </div>
    <div class="search-browse-groups">
      {browseGroups.map((game) => (
        <div class="search-browse-row">
          <strong>{game.displayName}</strong>
          <div class="search-browse-links">
            {game.categories.map((category) => (
              <a href={urls.sitePath(`/${game.slug}/${category.slug}/`)}>{category.label}<small>{formatCount(category.count)}</small></a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="page-container search-results" data-search-page data-search-query={query}>
    <div class="gallery-results-bar search-results-heading"><span data-search-status aria-live="polite">输入关键词搜索资源</span><button class="text-link search-retry" type="button" data-search-retry hidden>重试</button><GalleryDownload id="search-result-download" originalLabel="原文件" /></div>
    <p class="detail-note">打包每项资源的默认文件，可优先使用超分版。</p>
    <div class="search-empty" data-search-empty hidden>
      <p data-search-empty-copy>试试其他关键词，或从游戏库按分类查找。</p>
      <div><button class="button button-secondary" type="button" data-search-clear-category hidden>清除分类</button><button class="button button-secondary" type="button" data-search-clear-filters hidden>清除筛选</button><a class="button button-secondary" href={urls.sitePath("/games/")}>浏览游戏库</a><a class="text-link" href={urls.sitePath("/feedback/")}>反馈缺少的资源</a></div>
    </div>
    <div class="resource-grid" data-search-results></div>
    <div data-search-loading hidden><CardSkeleton /></div>
    <div class="gallery-more"><button class="button button-secondary" type="button" data-search-more hidden>加载更多</button></div>
  </section>
  <BatchTray originalLabel="下载原文件" />
  <script src="../../scripts/search-page.ts"></script>
</BaseLayout>
