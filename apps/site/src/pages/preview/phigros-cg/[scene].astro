---
import { getSiteData } from "../../../lib/site-data";
import { urls } from "../../../lib/site-urls";
export function getStaticPaths() { return ["secret", "deduction"].map(scene => ({ params: { scene } })); }
const title = Astro.params.scene === "secret" ? "秘密剧情 · 鸠与 Gino" : "推演 · 重逢";
const resource = getSiteData().resources.find(resource => resource.game === "phigros" && resource.resourceType === "story-cg" && resource.displayTitle === title);
return Astro.redirect(urls.sitePath(resource?.route ?? "/phigros/story-cg/"));
---
