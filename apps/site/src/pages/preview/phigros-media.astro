---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mediaItems, PREVIEW_MEDIA_ORIGIN } from "../../lib/phigros-media-preview";
import { getPublicNavigationGames } from "../../lib/site-data";
import { urls } from "../../lib/site-urls";
import "../../styles/phigros-media-preview.css";
if (!import.meta.env.DEV) return Astro.redirect(urls.sitePath("/phigros/"));
const clip = mediaItems[0].clips[0];
const categories = getPublicNavigationGames().find(game => game.slug === "phigros")!.categories;
const mib = (bytes: number) => `${(bytes / 1048576).toFixed(2)} MiB`;
const duration = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.round(seconds % 60)).padStart(2, "0")}`;
---
<BaseLayout title="Phigros 视频演出 | Rhythm Archive" description="Phigros 视频演出" canonicalPath="/preview/phigros-media/" bodyClass="phigros-media-preview">
  <div class="page-container media-archive" data-media-archive>
    <nav class="media-breadcrumb" aria-label="面包屑"><a href={urls.sitePath("/games/")}>游戏库</a><span>/</span><a href={urls.sitePath("/phigros/")}>Phigros</a><span>/</span><span>视频演出</span></nav>
    <header class="media-heading"><div><p class="media-eyebrow">Phigros</p><h1>视频演出</h1></div></header>
    <nav class="category-nav media-category-nav" aria-label="Phigros 分类">
      <span class="category-nav-label">资源类型</span>
      {categories.map(category => <>
        <a href={urls.sitePath(`/phigros/${category.slug}/`)}>{category.label}</a>
        {category.slug === "story-cg" ? <a class="is-active" href={urls.sitePath("/preview/phigros-media/")}>视频演出</a> : null}
      </>)}
    </nav>
    <section class="video-workspace">
      <div class="media-main">
        <div class="media-screen">
          <video data-player controls playsinline preload="none" hidden aria-label="视频演出播放器"></video>
          <div class="media-cover" data-cover>
            <img data-poster src={`${PREVIEW_MEDIA_ORIGIN}/posters/${clip.poster}`} alt="Exoplanetary Mirage 演出封面" width="640" height="360" />
            <div class="media-cover-shade"></div>
            <div class="media-spoiler" data-spoiler hidden><strong>剧情内容</strong><button type="button" class="button button-secondary" data-reveal>查看</button></div>
            <button type="button" class="media-play-button" data-play aria-label="播放视频"><span class="media-play-icon" aria-hidden="true">▶</span><span>播放</span></button>
            <span class="media-screen-duration" data-screen-duration>{duration(clip.duration)}</span>
          </div>
          <p class="media-player-error" data-player-error role="alert" hidden>视频无法播放，请稍后重试。</p>
        </div>
        <div class="media-player-toolbar"><label data-clip-label hidden>片段 <select data-clip aria-label="演出片段"></select></label><button type="button" class="media-stop" data-stop hidden>停止播放</button></div>
        <div class="media-resource-title media-video-title"><h2 data-title>Exoplanetary Mirage</h2><a class="button button-secondary media-download" data-download href={`${PREVIEW_MEDIA_ORIGIN}/originals/${clip.originalFile}?download=1`}>下载视频 <span data-original-size>{mib(clip.originalBytes)}</span></a></div>
        <p class="sr-only" data-status aria-live="polite"></p>
      </div>
      <aside class="media-playlist" aria-label="演出目录">
        <div class="media-playlist-heading"><h2>演出目录</h2><label class="sr-only" for="media-filter">筛选演出类型</label><select id="media-filter" data-filter><option value="all">全部演出</option><option value="unlock">曲目解锁</option><option value="story">剧情过场</option><option value="background">动态背景</option></select></div>
        <div class="media-playlist-items">
          {mediaItems.map((item, index) => <button type="button" class:list={{ "media-playlist-item": true, "is-selected": index === 0 }} data-item={index} data-kind={item.kind} aria-pressed={index === 0}>
            <div class="media-list-image">{item.spoiler ? <span class="media-list-spoiler">◇<small>剧情内容</small></span> : <img src={`${PREVIEW_MEDIA_ORIGIN}/posters/${item.clips[0].poster}`} alt="" loading="lazy" width="160" height="90" />}<span>{duration(item.clips[0].duration)}</span></div>
            <div><span class="media-item-category">{item.category}</span><strong>{item.title}</strong>{item.clips.length > 1 ? <small>{item.clips.length} 个片段</small> : null}</div>
          </button>)}
        </div>
      </aside>
    </section>
  </div>
  <script src="../../scripts/phigros-media-preview.ts"></script>
</BaseLayout>
