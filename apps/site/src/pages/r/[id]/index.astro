---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DownloadActions from "../../../components/DownloadActions.astro";
import VariantPanel from "../../../components/VariantPanel.astro";
import ResourceCard from "../../../components/ResourceCard.astro";
import { displayDifficultyLabel, GAME_CONFIG, primaryCategorySlug } from "../../../lib/game-config";
import { formatImageDimensions } from "../../../lib/format";
import { BASE_PATH, ROS_BASE_URL } from "../../../lib/site-config";
import { getSiteData } from "../../../lib/site-data";
import { rankRelatedResources } from "../../../lib/related";
import { createUrlHelpers } from "../../../lib/url";
import type { PublicResource } from "../../../lib/types";

const data = getSiteData();
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: "https://rhythmarchive.github.io", rosBaseUrl: ROS_BASE_URL });

export function getStaticPaths() {
  const siteData = getSiteData();
  return siteData.resources.map((resource) => ({ params: { id: resource.resourceId }, props: { resource } }));
}

const { resource } = Astro.props;
const firstVariant = resource.variants.find((variant) => variant.preferred) ?? resource.variants[0];
const activeVariantIndex = Math.max(0, firstVariant ? resource.variants.findIndex((variant) => variant.variantId === firstVariant.variantId) : 0);
const related = rankRelatedResources(resource, data.resources);
const hiddenDetailMetadata = new Set(["artist", "bpmSource", "gameVersion", "metadataStatus", "songId", "wikiBpm"]);
const metadata = Object.entries(resource.metadata).filter(([key]) => !hiddenDetailMetadata.has(key) && GAME_CONFIG[resource.game].metadataLabels[key]);
const facetLabels: Record<string, string> = {
  path: "剧情路径",
  chapter: "章节",
  entry: "剧情 Entry",
  locale: "语言",
  kind: "类型",
};
const facetMetadata = Object.entries(resource.facets ?? {})
  .filter(([key, values]) => key !== "chart" && facetLabels[key] && values.length > 0)
  .map(([key, values]) => [facetLabels[key]!, values.join("、")] as [string, string]);
const preview = firstVariant?.preview.large?.url ?? firstVariant?.preview.medium?.url ?? firstVariant?.preview.small?.url;
const difficultyValues = [...new Set(resource.variants.map((variant) => variant.difficulty).filter((value): value is string => Boolean(value)))];
const charts = resource.charts ?? [];
const specialCharts = resource.specialCharts ?? [];
const allCharts = [...charts, ...specialCharts];
const primaryDownload = resource.original ?? firstVariant?.original;
const primaryPreview = firstVariant?.preview.large ?? firstVariant?.preview.medium ?? firstVariant?.preview.small;
const dimensions = formatImageDimensions(primaryDownload?.width, primaryDownload?.height)
  ?? formatImageDimensions(primaryPreview?.width, primaryPreview?.height);
const technicalMetadata: Array<[string, string]> = [];
if (difficultyValues.length > 0 && !metadata.some(([key]) => key === "difficulty")) technicalMetadata.push(["难度", difficultyValues.join(" / ")]);
if (dimensions) technicalMetadata.push(["图片尺寸", dimensions]);
const sizeBytes = primaryDownload?.sizeBytes ?? resource.sizeBytes;
if (sizeBytes !== undefined) technicalMetadata.push(["文件大小", formatBytes(sizeBytes)]);

function formatBytes(value: number): string {
  if (value < 1024) return String(value) + " B";
  if (value < 1024 * 1024) return (value / 1024).toFixed(1) + " KB";
  return (value / (1024 * 1024)).toFixed(1) + " MB";
}
function formatMetadataValue(value: string | number | boolean): string {
  if (typeof value === "boolean") return value ? "是" : "否";
  if (value === "complete") return "完整";
  if (value === "partial") return "部分";
  if (value === "special") return "特殊谱面";
  if (value === "unresolved") return "待核实";
  return String(value);
}
function chartStatusLabel(status: NonNullable<PublicResource["charts"]>[number]["status"]): string | undefined {
  if (status === "legacy") return "历史谱面";
  if (status === "error") return "异常变体";
  if (status === "unavailable") return "暂不可用";
  return undefined;
}
function chartDifficultyLabel(difficulty: string): string {
  return displayDifficultyLabel(difficulty, resource.game);
}
const description = `${resource.displayTitle}${resource.artist ? ` · ${resource.artist}` : ""} - ${GAME_CONFIG[resource.game].displayName} 图片资源。`;
---

<BaseLayout title={`${resource.displayTitle} - ${GAME_CONFIG[resource.game].displayName} | Rhythm Archive`} description={description} canonicalPath={resource.route} ogImage={preview} bodyClass="detail-page">
  <div class="page-container detail-shell" data-detail-root>
    <div class="detail-breadcrumb"><a href={urls.sitePath(`/${resource.game}/${primaryCategorySlug(resource.game)}/`)}>{GAME_CONFIG[resource.game].displayName}</a><span>/</span><span>{resource.categoryLabel}</span></div>
    <div class="detail-layout">
      <div class="detail-visual">
        {resource.variants.length > 1 ? (
          <div class="variant-tabs" role="tablist" aria-label="资源版本">
            {resource.variants.map((variant, index) => <button class:list={{ "is-active": index === activeVariantIndex }} type="button" data-variant-select={variant.variantId} role="tab" aria-selected={index === activeVariantIndex ? "true" : "false"}>{variant.label}</button>)}
          </div>
        ) : null}
        <div class="variant-panels">
          {resource.variants.map((variant, index) => <VariantPanel variant={variant} fallback={variant.original} active={index === activeVariantIndex} alt={resource.displayTitle} />)}
        </div>
      </div>
      <aside class="detail-info">
        <span class="section-kicker">{resource.categoryLabel}</span>
        <h1>{resource.displayTitle}</h1>
        {resource.artist ? <p class="detail-artist">{resource.artist}</p> : null}
        {resource.subtitle ? <p class="detail-subtitle">{resource.subtitle}</p> : null}
        {resource.badges && resource.badges.length > 0 ? <div class="detail-badges" aria-label="资源标签">{resource.badges.map((badge) => <span class="detail-badge">{badge}</span>)}</div> : null}
        <dl class="detail-meta">
          <div><dt>游戏</dt><dd>{GAME_CONFIG[resource.game].displayName}</dd></div>
          <div><dt>分类</dt><dd>{resource.categoryLabel}</dd></div>
          {metadata.map(([key, value]) => <div><dt>{GAME_CONFIG[resource.game].metadataLabels[key]}</dt><dd>{formatMetadataValue(value)}</dd></div>)}
          {facetMetadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          {technicalMetadata.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}
        </dl>
        {resource.resourceType === "jacket" ? (
          <section class="detail-chart-section" aria-labelledby="detail-chart-heading">
            <div class="detail-section-heading"><h2 id="detail-chart-heading">谱面难度</h2><span>{allCharts.length > 0 ? `${allCharts.length} 个` : "暂无数据"}</span></div>
            {allCharts.length > 0 ? (
              <div class="detail-chart-list">
                {allCharts.map((chart) => (
                  <div class="detail-chart-row">
                    <div class="detail-chart-main"><strong>{chartDifficultyLabel(chart.difficulty)}</strong>{chart.level ? <span>等级 {chart.level}</span> : null}{chart.notes !== undefined ? <span>Notes {chart.notes}</span> : null}{chart.constant ? <span>定数 {chart.constant}</span> : null}</div>
                    <div class="detail-chart-copy">
                      {chart.title ? <span>{chart.title}</span> : null}
                      {chart.artist ? <span>{chart.artist}</span> : null}
                      {chart.noter ? <span>谱师：{chart.noter}</span> : null}
                      {chartStatusLabel(chart.status) ? <span class="detail-chart-status">{chartStatusLabel(chart.status)}</span> : null}
                    </div>
                  </div>
                ))}
              </div>
            ) : <p class="detail-note">当前适配器尚未提供可用的谱面难度数据。</p>}
          </section>
        ) : null}
        <div class="detail-downloads">
          {resource.variants.map((variant, index) => <DownloadActions variant={variant} active={index === activeVariantIndex} />)}
        </div>
      </aside>
    </div>
    {related.length > 0 ? (
      <section class="related-section" aria-labelledby="related-heading">
        <div class="section-heading"><div><h2 id="related-heading">相关资源</h2></div></div>
        <div class="resource-grid related-grid">{related.map((item, index) => <ResourceCard resource={item} index={index} />)}</div>
      </section>
    ) : null}
    <div class="detail-lightbox" data-detail-lightbox hidden role="dialog" aria-modal="true" aria-label="大图预览">
      <button class="detail-lightbox-backdrop" type="button" data-lightbox-close aria-label="关闭大图预览"></button>
      <div class="detail-lightbox-content">
        <img data-lightbox-image alt="" decoding="async" />
        <button class="detail-lightbox-close" type="button" data-lightbox-close aria-label="关闭大图预览">×</button>
      </div>
    </div>
  </div>
  <script src="../../../scripts/detail.ts"></script>
</BaseLayout>
