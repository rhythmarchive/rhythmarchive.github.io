---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Giscus from "../../components/Giscus.astro";
import { BILIBILI_URL, GITHUB_FEEDBACK_CATEGORY_URL } from "../../lib/site-config";

const description = "发现资源错误、下载问题，或者有其他建议，都可以在这里反馈。";
---

<BaseLayout title="意见反馈 | Rhythm Archive" description="向 Rhythm Archive 反馈音游曲绘、图片资源与下载中遇到的问题，或提出网站使用建议。发现资源名称、图片内容或下载链接有误时，可通过这里的反馈入口提供具体信息。" canonicalPath="/feedback/" bodyClass="feedback-page">
  <section class="page-container feedback-head page-heading">
    <span class="archive-kicker">Rhythm Archive</span>
    <h1>意见反馈</h1>
    <p>{description}</p>
    <div class="feedback-links">
      <a class="button button-secondary" href={GITHUB_FEEDBACK_CATEGORY_URL} target="_blank" rel="noopener noreferrer">GitHub 反馈</a>
      <a class="button button-secondary" href={BILIBILI_URL} target="_blank" rel="noopener noreferrer">B站联系</a>
    </div>
  </section>
  <section class="page-container feedback-body" aria-label="反馈区">
    <Giscus />
  </section>
</BaseLayout>
