---
import type { RangeHistogram } from "../lib/range-histogram";

interface Props {
  histogram: RangeHistogram | undefined;
  min: number;
  max: number;
  label: string;
}

// Bars share the slider's value axis, so a bar sits exactly above the values it selects.
const { histogram, min, max, label } = Astro.props;
const span = max - min;
const peak = histogram ? Math.max(...histogram.counts, 1) : 1;
const bars = histogram && span > 0 ? histogram.counts.map((count, index) => {
  const low = Math.max(min, histogram.start + index * histogram.size);
  const high = Math.min(max, histogram.start + (index + 1) * histogram.size);
  return { index, count, left: ((low - min) / span) * 100, width: ((high - low) / span) * 100 };
}).filter((bar) => bar.width > 0) : [];
---

{bars.length > 1 ? (
  <div class="range-histogram" data-range-histogram data-start={histogram!.start} data-size={histogram!.size} title={`点按或拖动柱条，快速选择${label}区间`} aria-hidden="true">
    {bars.map((bar, order) => <span style={`--i: ${order}; --l: ${bar.left.toFixed(3)}%; --w: ${bar.width.toFixed(3)}%; --h: ${Math.max(bar.count / peak, bar.count > 0 ? .08 : 0).toFixed(3)}`} data-index={bar.index} data-count={bar.count}></span>)}
  </div>
) : null}
