---
import CardShell from "./CardShell.astro";
import { browseCardView } from "../lib/card-view-model";
import type { BrowseGalleryItem } from "../lib/browse-gallery";

interface Props {
  item: BrowseGalleryItem;
  selectable?: boolean;
  eager?: boolean;
}

const { item, selectable = false, eager = false } = Astro.props;
const view = browseCardView(item);
---

<CardShell view={view} selectable={selectable} eager={eager} browse />