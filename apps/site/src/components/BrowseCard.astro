---
import type { BrowseGalleryItem } from "../lib/browse-gallery";
import { cardMediaFit, cardMediaRatio } from "../lib/media-config";
import { BASE_PATH } from "../lib/site-config";
import { createUrlHelpers } from "../lib/url";

interface Props {
  item: BrowseGalleryItem;
  selectable?: boolean;
  eager?: boolean;
}

const { item, selectable = false, eager = false } = Astro.props;
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: "https://rhythmarchive.github.io", rosBaseUrl: "https://rhythm-assets.cn-nb1.rains3.com" });
const small = item.preview.small ?? item.preview.medium ?? item.preview.large;
const useOriginalGallerySource = ["arcaea", "paradigm-reboot"].includes(item.game) && item.resourceType === "jacket" && Boolean(item.original);
const gallerySource = useOriginalGallerySource ? item.original : small;
const galleryFallback = useOriginalGallerySource ? small : item.original;
const gallerySrcset = useOriginalGallerySource ? "" : [item.preview.small ? item.preview.small.url + " 320w" : "", item.preview.medium ? item.preview.medium.url + " 640w" : ""].filter(Boolean).join(", ");
const metadata = [...(item.badges ?? []), item.badge, item.selectedArtworkDifficulty, item.selectedChartDifficulty, item.game === "arcaea" || item.game === "phigros" ? item.pack : undefined].filter((value): value is string => Boolean(value));
---

<article class="resource-card" data-browse-card data-resource-card data-resource-id={item.resourceId} data-game={item.game} data-resource-type={item.resourceType} data-media-ratio={cardMediaRatio(item.game, item.resourceType)} data-media-fit={cardMediaFit(item.game, item.resourceType)}>
  {selectable ? (
    <button class="resource-select" type="button" data-select-resource={item.resourceId} aria-pressed="false" aria-label={`选择 ${item.displayTitle}`}>
      <span aria-hidden="true">✓</span>
    </button>
  ) : null}
  <a class="resource-card-link" href={urls.sitePath(item.route)}>
    <div class="resource-card-media">
      {gallerySource ? (
        <img
          src={gallerySource.url}
          srcset={gallerySrcset || undefined}
          data-fallback-src={galleryFallback?.url}
          data-fallback-width={galleryFallback?.width}
          data-fallback-height={galleryFallback?.height}
          sizes="(max-width: 640px) 50vw, (max-width: 1280px) 20vw, 210px"
          alt={item.displayTitle}
          width={gallerySource.width ?? small?.width}
          height={gallerySource.height ?? small?.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
      ) : <div class="resource-card-placeholder" aria-label="图片加载失败">图片暂不可用</div>}
      {item.hasUpscaled ? <span class="resource-badge is-upscaled">含超分版</span> : null}
    </div>
    <div class="resource-card-body">
      <h3>{item.displayTitle}</h3>
      {item.artist ? <p>{item.artist}</p> : null}
      {metadata.map((value) => <span class="resource-card-variant">{value}</span>)}
      <span class="resource-card-views" data-resource-views hidden aria-label="浏览量"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-5.5 9.5-5.5 9.5 5.5 9.5 5.5-3.5 5.5-9.5 5.5S2.5 12 2.5 12Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg><span data-resource-views-value>0</span></span>
    </div>
  </a>
</article>
