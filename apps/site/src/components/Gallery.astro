---
import ResourceCard from "./ResourceCard.astro";
import RangeHistogram from "./RangeHistogram.astro";
import GalleryFilters from "./GalleryFilters.astro";
import BatchTray from "./BatchTray.astro";
import GalleryLoadError from "./GalleryLoadError.astro";
import GalleryDownload from "./GalleryDownload.astro";
import { GAME_CONFIG, type GameId } from "../lib/game-config";
import type { CategoryBrowseConfig } from "../lib/category-browse";
import type { PublicResource } from "../lib/types";
import { BASE_PATH } from "../lib/site-config";
import { formatCount } from "../lib/format";
import { GALLERY_IMAGE_SIZES, SIDEBAR_IMAGE_SIZES } from "../lib/card-preview";

interface Props {
  resources: PublicResource[];
  total: number;
  game: GameId;
  category: string;
  categoryLabel: string;
  galleryUrl: string;
  config: CategoryBrowseConfig;
  defer?: boolean;
}

const { resources, total, game, category, categoryLabel, galleryUrl, config, defer = false } = Astro.props;
const hasFacets = config.facets.some((facet) => facet.options.length > 0 || facet.range);

function rangeTicks(min: number, max: number, step: number): number[] {
  const tickStep = Math.max(step, Math.ceil(((max - min) / 7) / step) * step);
  const values = [min];
  for (let value = min + tickStep; value < max - step / 2; value += tickStep) values.push(Number(value.toFixed(4)));
  if (values[values.length - 1] !== max) values.push(max);
  return values;
}

function formatRangeValue(value: number): string {
  return Number.isInteger(value) ? String(value) : String(Number(value.toFixed(2)));
}
---

<section class:list={["gallery-shell", { "has-filters": hasFacets }]} data-gallery-root data-gallery-defer={defer ? "true" : undefined} data-gallery-url={galleryUrl} data-batch-url={galleryUrl.replace("/galleries/", "/batch/")} data-base-path={BASE_PATH} data-game={game} data-category={category} data-total={total}>
  <script is:inline data-astro-rerun>
    (() => {
      const galleryRoot = document.currentScript?.closest("[data-gallery-root]");
      if (galleryRoot && galleryRoot.getAttribute("data-gallery-defer") !== "true") galleryRoot.setAttribute("aria-busy", "true");
    })();
  </script>
  {Astro.slots.has("heading") ? <div class="gallery-content-heading"><slot name="heading" /></div> : null}
  <div class="gallery-toolbar">
    <div class="gallery-toolbar-copy">
      <span class="section-kicker">{category === "all" ? GAME_CONFIG[game].displayName : categoryLabel}</span>
      <p data-gallery-count aria-hidden="true">{formatCount(total)} 项资源</p>
      {!hasFacets ? <div class="active-filter-row" data-gallery-active hidden>
        <div class="active-filter-chips" data-gallery-active-chips></div>
        <button class="text-link" type="button" data-gallery-reset>清除</button>
      </div> : null}
    </div>
    <div class="gallery-toolbar-controls">
      {hasFacets ? <button class="button button-secondary gallery-filter-open" type="button" data-filter-open aria-haspopup="dialog" aria-controls={`gallery-filters-${game}-${category}`}>筛选 <span data-filter-summary></span></button> : null}
      <label class="gallery-search">
        <span class="sr-only">{config.searchPlaceholder}</span>
        <svg class="gallery-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg>
        <input type="search" data-gallery-search placeholder={config.searchPlaceholder} autocomplete="off" />
      </label>
      {config.sortOptions.length > 1 ? (
        <label class="sort-control">
          <span>排序</span>
          <select data-gallery-sort aria-label="排序">
            {config.sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
      ) : null}
    </div>
  </div>

  <div class="gallery-results-bar"><span data-gallery-result-count role="status" aria-live="polite" aria-atomic="true">{formatCount(total)} 项资源</span><GalleryDownload id={`gallery-download-${game}-${category}`} /></div>

  {hasFacets ? (
    <GalleryFilters id={`gallery-filters-${game}-${category}`}>
  <div class="active-filter-row" data-gallery-active hidden>
    <span class="active-filter-label">当前筛选</span>
    <div class="active-filter-chips" data-gallery-active-chips></div>
    <button class="text-link" type="button" data-gallery-reset>清除全部</button>
  </div>

    <div class="gallery-filter-row" data-gallery-filter-row>
      {config.facets.filter((facet) => facet.range || facet.options.length > 0).map((facet) => (
        facet.range ? (
          <div class="filter-range-control" data-gallery-range={facet.key} data-range-label={facet.label} data-range-min={facet.range.min} data-range-max={facet.range.max} data-range-step={facet.range.step}>
            <div class="filter-range-header">
              <span class="filter-range-label">{facet.label}</span>
              <div class="filter-range-values" role="group" aria-label={`${facet.label}范围`}>
                <label class="filter-range-input">
                  <span class="sr-only">{facet.label}最小值</span>
                  <input type="number" data-gallery-range-min-input min={facet.range.min} max={facet.range.max} step={facet.range.step} value={facet.range.min} inputmode="decimal" />
                </label>
                <span aria-hidden="true">～</span>
                <label class="filter-range-input">
                  <span class="sr-only">{facet.label}最大值</span>
                  <input type="number" data-gallery-range-max-input min={facet.range.min} max={facet.range.max} step={facet.range.step} value={facet.range.max} inputmode="decimal" />
                </label>
              </div>
            </div>
            <RangeHistogram histogram={facet.histogram} min={facet.range.min} max={facet.range.max} label={facet.label} />
            <div class="filter-range-slider" data-gallery-range-slider>
              <div class="filter-range-track" aria-hidden="true"></div>
              <div class="filter-range-fill" aria-hidden="true"></div>
              <input type="range" data-gallery-range-min-slider min={facet.range.min} max={facet.range.max} step={facet.range.step} value={facet.range.min} aria-label={`${facet.label}最小值`} />
              <input type="range" data-gallery-range-max-slider min={facet.range.min} max={facet.range.max} step={facet.range.step} value={facet.range.max} aria-label={`${facet.label}最大值`} />
            </div>
            <div class="filter-range-ticks" aria-hidden="true">
              {rangeTicks(facet.range.min, facet.range.max, facet.range.step).map((value) => <span>{formatRangeValue(value)}</span>)}
            </div>
          </div>
        ) : (
          <label class="filter-control">
            <span>{facet.label}</span>
            <select data-gallery-facet={facet.key} aria-label={facet.label}>
              <option value="">全部</option>
              {facet.options.map((option) => <option value={option.value}>{option.label}</option>)}
            </select>
          </label>
        )
      ))}
    </div>
    </GalleryFilters>
  ) : null}

  <GalleryLoadError />
  <div class="gallery-grid" data-gallery-grid>
    {resources.map((resource, index) => <ResourceCard resource={resource} index={index} selectable eager={index < 6} sizes={hasFacets ? SIDEBAR_IMAGE_SIZES : GALLERY_IMAGE_SIZES} />)}
  </div>

  <div class="gallery-more">
    <button class="button button-secondary" type="button" data-load-more hidden={resources.length >= total}>加载更多</button>
  </div>

  <BatchTray />
</section>

<script src="../scripts/gallery.ts"></script>
