---
import ResourceCard from "./ResourceCard.astro";
import { GAME_CONFIG, type GameId } from "../lib/game-config";
import type { PublicResource } from "../lib/types";
import { BASE_PATH } from "../lib/site-config";
import { formatCount } from "../lib/format";

interface Props {
  resources: PublicResource[];
  total: number;
  game: GameId;
  category: string;
  categoryLabel: string;
  galleryUrl: string;
  difficultyOptions?: string[];
  hasUpscale?: boolean;
}

const { resources, total, game, category, categoryLabel, galleryUrl, difficultyOptions = [], hasUpscale = false } = Astro.props;
const hasDifficulty = difficultyOptions.length > 0;
---

<section class="gallery-shell" data-gallery-root data-gallery-url={galleryUrl} data-base-path={BASE_PATH} data-game={game} data-category={category} data-total={total}>
  <div class="gallery-toolbar">
    <div class="gallery-toolbar-copy">
      <span class="section-kicker">{category === "all" ? GAME_CONFIG[game].displayName : categoryLabel}</span>
      <p data-gallery-count>显示 {formatCount(Math.min(resources.length, total))} / {formatCount(total)}</p>
    </div>
    <div class="gallery-toolbar-actions">
      {(hasDifficulty || hasUpscale) ? <button class="filter-toggle" type="button" data-filter-toggle aria-expanded="false">筛选</button> : null}
      <button class="text-link" type="button" data-gallery-reset>清除筛选</button>
    </div>
  </div>

  {(hasDifficulty || hasUpscale) ? (
    <div class="filter-panel" data-filter-panel hidden>
      {hasDifficulty ? (
        <label class="filter-control">
          <span>难度</span>
          <select data-filter-difficulty>
            <option value="">全部</option>
            {difficultyOptions.map((difficulty) => <option value={difficulty}>{difficulty}</option>)}
          </select>
        </label>
      ) : null}
      {hasUpscale ? (
        <label class="filter-check"><input type="checkbox" data-filter-ai /> <span>仅看含超分版</span></label>
      ) : null}
    </div>
  ) : null}

  <div class="gallery-grid" data-gallery-grid>
    {resources.map((resource, index) => <ResourceCard resource={resource} index={index} selectable eager={index < 6} />)}
  </div>

  <div class="gallery-more">
    <button class="button button-secondary" type="button" data-load-more hidden={resources.length >= total}>加载更多</button>
  </div>

  <div class="batch-bar" data-batch-bar hidden>
    <div>
      <strong data-batch-count>已选择 0 项</strong>
      <span data-batch-status aria-live="polite"></span>
    </div>
    <div class="batch-actions">
      <button class="button button-secondary" type="button" data-batch-download="original">下载原图</button>
      <button class="button button-primary" type="button" data-batch-download="upscaled">优先超分版</button>
    </div>
  </div>
</section>

<script src="../scripts/gallery.ts"></script>
