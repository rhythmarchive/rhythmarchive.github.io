---

import { urls } from "../lib/site-urls";

interface Props {
  compact?: boolean;
  initialQuery?: string;
  label?: string;
}

const { compact = false, initialQuery = "", label = "搜索资源" } = Astro.props;

---

<form class:list={["search-box", { "is-compact": compact }]} action={urls.sitePath("/search/")} method="get" role="search" data-search-entry>
  <label class="sr-only" for={`search-${compact ? "compact" : "main"}`}>{label}</label>
  <svg class="search-box-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg>
  <input id={`search-${compact ? "compact" : "main"}`} name="q" type="search" value={initialQuery} placeholder="曲名、曲师或资源名称" autocomplete="off" />
  <button type="submit">搜索</button>
</form>

<script src="../scripts/search-entry.ts"></script>
