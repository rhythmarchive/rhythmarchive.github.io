---
import { getPublicNavigationGames } from "../lib/site-data";
import { BASE_PATH, BILIBILI_URL, ROS_BASE_URL, SITE_ORIGIN } from "../lib/site-config";
import { createUrlHelpers } from "../lib/url";
import { primaryCategorySlug } from "../lib/game-config";

const urls = createUrlHelpers({ basePath: BASE_PATH, origin: SITE_ORIGIN, rosBaseUrl: ROS_BASE_URL });
const games = getPublicNavigationGames();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <strong>Rhythm Archive</strong>
      <span>把节奏游戏里的图像，整理成容易找到的收藏。</span>
    </div>
    <nav class="site-footer-links" aria-label="页脚导航">
      <a href={urls.sitePath("/games/")}>游戏库</a>
      {games.map((game) => <a href={urls.sitePath(`/${game.slug}/${primaryCategorySlug(game.slug)}/`)}>{game.displayName}</a>)}
      <a href={urls.sitePath("/feedback/")}>意见反馈</a>
      <a href={BILIBILI_URL} target="_blank" rel="noopener noreferrer">B站主页</a>
    </nav>
  </div>
</footer>
