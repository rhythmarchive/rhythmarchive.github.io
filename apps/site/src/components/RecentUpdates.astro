---
import UpdateCard from "./UpdateCard.astro";
import UpdateReminder from "./UpdateReminder.astro";
import { getPublicNavigationGames, getSiteData } from "../lib/site-data";
import { BASE_PATH, PUBLIC_STATS_API_URL, PUBLIC_UPDATE_REMINDERS_ENABLED, ROS_BASE_URL, SITE_ORIGIN } from "../lib/site-config";
import { createUrlHelpers } from "../lib/url";

const siteData = getSiteData();
const updates = siteData.updates.slice(0, 3);
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: SITE_ORIGIN, rosBaseUrl: ROS_BASE_URL });
const updateReminderGames = updates.length > 0 && PUBLIC_UPDATE_REMINDERS_ENABLED && PUBLIC_STATS_API_URL ? getPublicNavigationGames() : [];
---

{updates.length > 0 && (
  <section class="page-container home-recent-updates" aria-labelledby="recent-updates-heading">
    <div class="section-heading">
      <div><span class="section-kicker">Updates</span><h2 id="recent-updates-heading">最近更新</h2></div>
      <a class="section-link recent-updates-entry" href={urls.sitePath("/updates/")}>查看更新记录 <span aria-hidden="true">→</span></a>
    </div>
    <div class="recent-update-list">
      {updates.map((update) => <UpdateCard update={update} compact />)}
    </div>
    {updateReminderGames.length > 0 && <UpdateReminder games={updateReminderGames} />}
  </section>
)}
