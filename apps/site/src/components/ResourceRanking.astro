---
import { BASE_PATH, ROS_BASE_URL, SITE_ORIGIN } from "../lib/site-config";
import { createUrlHelpers } from "../lib/url";

interface Props {
  compact?: boolean;
  limit?: number;
  headingId: string;
}

const { compact = false, limit = 30, headingId } = Astro.props;
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: SITE_ORIGIN, rosBaseUrl: ROS_BASE_URL });
---

<section
  class:list={["page-container", "resource-ranking", compact ? "resource-ranking-home" : "resource-ranking-page"]}
  data-ranking-root
  data-ranking-compact={compact ? "true" : undefined}
  data-ranking-limit={limit}
  data-ranking-cards-url={urls.sitePath("/data/ranking-cards.json")}
  aria-labelledby={headingId}
>
  {compact ? (
    <div class="section-heading">
      <div><span class="section-kicker">Discovery</span><h2 id={headingId}>热门资源</h2></div>
      <div class="resource-ranking-heading-actions">
        <div class="ranking-period-switch" role="group" aria-label="热榜范围">
          <button type="button" data-ranking-period="7d" aria-pressed="true">近 7 天</button>
          <button type="button" data-ranking-period="all" aria-pressed="false">累计</button>
        </div>
        <a class="section-link" href={urls.sitePath("/ranking/")}>完整热榜 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  ) : (
    <div class="ranking-page-head">
      <span class="archive-kicker">Discovery</span>
      <h1 id={headingId}>资源热榜</h1>
      <p>按有效浏览量排序，浏览量相同时以下载量排序。</p>
      <div class="ranking-page-controls">
        <div class="ranking-period-switch" role="group" aria-label="热榜范围">
          <button type="button" data-ranking-period="7d" aria-pressed="true">近 7 天</button>
          <button type="button" data-ranking-period="all" aria-pressed="false">累计</button>
        </div>
        <a class="text-link" href={urls.sitePath("/")}>返回首页</a>
      </div>
    </div>
  )}

  <div class="ranking-list" data-ranking-list></div>
  <p class="ranking-status" data-ranking-status aria-live="polite">正在获取热榜…</p>
  <button class="button button-secondary ranking-retry" type="button" data-ranking-retry hidden>重试</button>
</section>

<script src="../scripts/ranking.ts"></script>