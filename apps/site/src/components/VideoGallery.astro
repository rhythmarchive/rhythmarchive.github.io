---
import type { PublicResource } from "../lib/types";
import { buildMediaItems } from "../lib/media";
import "../styles/media-gallery.css";
interface Props { resources: PublicResource[] }
const items = buildMediaItems(Astro.props.resources);
const first = items[0]!, clip = first.clips[0]!;
const duration = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.round(seconds % 60)).padStart(2, "0")}`;
const size = (bytes: number) => `${(bytes / 1048576).toFixed(2)} MiB`;
---
<section class="video-workspace" data-video-gallery data-media-items={JSON.stringify(items)}>
  <div class="media-main">
    <div class="media-screen">
      <video data-player controls playsinline preload="none" hidden aria-label="视频演出播放器"></video>
      <div class="media-cover" data-cover>
        <img data-poster src={first.spoiler ? undefined : clip.poster} hidden={first.spoiler} alt={`${first.title} 演出封面`} />
        <div class="media-cover-shade"></div>
        <div class="media-spoiler" data-spoiler hidden={!first.spoiler}><strong>剧情内容</strong><button type="button" class="button button-secondary" data-reveal>查看</button></div>
        <button type="button" class="media-play-button" data-play hidden={first.spoiler} aria-label="播放视频"><span class="media-play-icon" aria-hidden="true">▶</span><span>播放</span></button>
        <span class="media-screen-duration" data-screen-duration>{duration(clip.duration)}</span>
      </div>
      <p class="media-player-error" data-player-error role="alert" hidden>视频无法播放，请稍后重试。</p>
    </div>
    <div class="media-player-toolbar"><label data-clip-label hidden>片段 <select data-clip aria-label="演出片段"></select></label><button type="button" class="media-stop" data-stop hidden>停止播放</button></div>
    <slot name="resource-info" />
    <div class="media-resource-title media-video-title"><h2 data-title>{first.title}</h2><button type="button" class="button button-secondary media-download" data-download data-download-url={clip.original.url} data-download-filename={clip.original.downloadFilename} data-resource-id={first.id}>下载视频 <span data-original-size>{size(clip.original.sizeBytes)}</span></button></div>
    <p class="sr-only" data-status aria-live="polite"></p>
  </div>
  {items.length > 1 ? <aside class="media-playlist" aria-label="演出目录">
    <div class="media-playlist-heading"><h2>演出目录</h2><label class="sr-only" for="media-filter">筛选演出类型</label><select id="media-filter" data-filter><option value="all">全部演出</option><option value="unlock">曲目解锁</option><option value="story">剧情过场</option><option value="background">动态背景</option></select></div>
    <div class="media-playlist-items">{items.map((item, index) => <button type="button" class:list={{ "media-playlist-item": true, "is-selected": index === 0 }} data-item={index} data-kind={item.kind} aria-pressed={index === 0}>
      <div class="media-list-image">{item.spoiler ? <span class="media-list-spoiler">◇<small>剧情内容</small></span> : <><img data-viewport-src={item.clips[0]!.poster} alt="" loading="lazy" /><noscript><img src={item.clips[0]!.poster} alt="" loading="lazy" /></noscript></>}<span>{duration(item.clips[0]!.duration)}</span></div>
      <div><span class="media-item-category">{item.category}</span><strong>{item.title}</strong>{item.clips.length > 1 ? <small>{item.clips.length} 个片段</small> : null}</div>
    </button>)}</div>
  </aside> : null}
</section>
<script src="../scripts/video-gallery.ts"></script>
