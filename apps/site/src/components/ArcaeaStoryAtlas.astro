---
import type { ArcaeaStoryAtlasType, ArcaeaStoryStructureType } from "../../../../packages/domain/src/browse.js";
import { buildArcaeaStoryAtlasLayout, buildArcaeaStorySubworldLayout, type StoryAtlasNodeLabel } from "../lib/arcaea-story-layout";
import { buildArcaeaStoryExplorerModel, type ArcaeaStoryExplorerEntry, type ArcaeaStoryExplorerScene } from "../lib/arcaea-story-explorer";
import { BASE_PATH } from "../lib/site-config";
import { sitePath } from "../lib/url";
import type { PublicAsset, PublicResource } from "../lib/types";

interface Props {
  resources: PublicResource[];
  storyStructure: ArcaeaStoryStructureType;
  storyAtlas?: ArcaeaStoryAtlasType;
  storyUi?: Record<string, PublicResource>;
  storyAvatars?: PublicResource[];
}

const { resources, storyStructure, storyAtlas, storyUi = {}, storyAvatars = [] } = Astro.props as Props;
const model = buildArcaeaStoryExplorerModel(resources, storyStructure, storyAtlas);
const layouts = new Map(model.sections.map((section) => [section.act, buildArcaeaStoryAtlasLayout(section, storyAtlas)]));
const finaleSource = storyAtlas?.layout?.subworlds?.find((subworld) => subworld.subworldId === "final-verdict");
const finalVerdictPath = model.paths.find((storyPath) => storyPath.pathId === 19);
const finalUnassignedCg = finalVerdictPath?.unassignedCg;
const finaleLayout = finaleSource ? buildArcaeaStorySubworldLayout(finaleSource, finalVerdictPath?.unassignedCg) : undefined;
const firstSection = model.sections[0];
const firstPath = firstSection?.paths[0];
const firstEntry = firstPath?.entries[0];
const SECTION_SEPARATOR = String.fromCharCode(0x00b7);

function sectionParts(label: string): { act: string; part: string } {
  const parts = label.split(SECTION_SEPARATOR).map((value) => value.trim());
  return { act: parts[0] ?? label, part: parts[1] ?? label };
}

function resourceHref(resource: PublicResource): string {
  return sitePath(resource.route, BASE_PATH);
}

function resourceImage(resource: PublicResource): PublicAsset | undefined {
  return resource.preview.small ?? resource.preview.medium ?? resource.preview.large ?? undefined;
}

function derivativeUi(filename: string): PublicAsset | undefined {
  const asset = storyAtlas?.derivatives?.ui[filename];
  if (asset) return { url: sitePath(asset.url, BASE_PATH), width: asset.width, height: asset.height, mime: asset.mime };
  return storyUi[filename] ? resourceImage(storyUi[filename]) : undefined;
}

function derivativeResource(resource: PublicResource, size: "thumb" | "preview"): PublicAsset | undefined {
  const asset = storyAtlas?.derivatives?.resources[resource.resourceId]?.[size];
  if (asset) return { url: sitePath(asset.url, BASE_PATH), width: asset.width, height: asset.height, mime: asset.mime };
  return size === "thumb"
    ? resource.preview.small ?? resource.preview.medium ?? undefined
    : resource.preview.medium ?? resource.preview.large ?? resource.preview.small ?? undefined;
}

function avatarResource(characterId: number): PublicResource | undefined {
  const expected = new RegExp("(?:^|[_-])" + characterId + "(?:[a-z])?_icon\\.png$", "iu");
  return storyAvatars.find((resource) => {
    const filenames = [
      resource.original?.downloadFilename,
      resource.downloadFilename,
      ...resource.variants.flatMap((variant) => [
        variant.original?.downloadFilename,
        ...(variant.originals?.map((original) => original.downloadFilename) ?? []),
      ]),
    ].filter((filename): filename is string => Boolean(filename));
    return filenames.some((filename) => expected.test(filename.replaceAll("\\", "/")));
  });
}

function avatarImage(characterId: number): PublicAsset | undefined {
  const resource = avatarResource(characterId);
  const asset = resource ? storyAtlas?.derivatives?.avatars[resource.resourceId] : undefined;
  if (asset) return { url: sitePath(asset.url, BASE_PATH), width: asset.width, height: asset.height, mime: asset.mime };
  return resource ? resourceImage(resource) : undefined;
}

function avatarLabel(characterId: number): string {
  return avatarResource(characterId)?.displayTitle ?? "Partner " + characterId;
}

function nodeImage(entry: ArcaeaStoryExplorerEntry): PublicAsset | undefined {
  if (/^F-\d+$/u.test(entry.key)) return derivativeUi("finale-" + entry.key.slice(2) + ".png");
  return entry.iconKey ? derivativeUi(entry.iconKey + ".png") : undefined;
}

function continuationImage(nodeId: string): PublicAsset | undefined {
  return derivativeUi(nodeId === "epilogue_a" ? "epilogue-a.png" : "epilogue-b.png");
}

function sectionArtwork(sectionLabel: string): PublicAsset | undefined {
  const parts = sectionParts(sectionLabel);
  const act = parts.act === "Act II" ? 2 : 1;
  const part = parts.part === "Part II" ? 2 : parts.part === "Part III" ? 3 : 1;
  return derivativeUi("act" + act + "-part" + part + ".png");
}

function storyUiAsset(filename: string): PublicAsset | undefined {
  return derivativeUi(filename);
}

function compactEntry(entry: ArcaeaStoryExplorerEntry, pathTitle: string, sectionLabel: string, sectionAct: number, characterIds: number[]): Record<string, unknown> {
  const subworldId = /^(?:F|E)-/u.test(entry.key) ? "final-verdict" : undefined;
  const endingLabel = entry.key === "E-1" ? "One Last Dream" : entry.key === "E-2" ? "A Perfect Wish" : undefined;
  return {
    id: sectionAct + ":" + entry.pathId + ":" + entry.key,
    pathId: entry.pathId,
    key: entry.key,
    pathTitle,
    sectionLabel,
    sectionAct,
    ...(subworldId ? { subworldId } : {}),
    ...(endingLabel ? { endingLabel } : {}),
    visualLabel: entry.visualLabel,
    characterIds,
    characterLabels: characterIds.map(avatarLabel),
    relatedSongs: entry.relatedSongs,
    unlockLabel: entry.unlockLabel,
    staffRoll: entry.staffRoll,
    storyType: entry.text?.storyType,
    storyData: entry.text?.storyData,
    sceneIds: entry.sceneIds,
    resourceIds: entry.resources.map((resource) => resource.resourceId),
  };
}

function compactScene(scene: ArcaeaStoryExplorerScene, pathTitle: string, sectionLabel: string, sectionAct: number): Record<string, unknown> {
  return {
    sceneId: scene.sceneId,
    pathId: scene.pathId,
    pathTitle,
    sectionLabel,
    sectionAct,
    kind: scene.kind,
    displayTitle: scene.displayTitle ?? scene.sceneId,
    ...(scene.isUnassignedCg ? { isUnassignedCg: true } : {}),
    scriptStem: scene.scriptStem,
    resourceIds: scene.resources.map((resource) => resource.resourceId),
  };
}

function compactResource(resource: PublicResource): Record<string, unknown> {
  const thumb = derivativeResource(resource, "thumb");
  const preview = derivativeResource(resource, "preview");
  return {
    resourceId: resource.resourceId,
    route: resourceHref(resource),
    title: resource.displayTitle,
    subtitle: resource.subtitle,
    thumb: thumb?.url,
    preview: preview?.url,
    original: resource.original?.url,
    download: resource.original?.url,
    downloadFilename: resource.original?.downloadFilename ?? resource.downloadFilename,
    assetPaths: (resource.searchTerms ?? []).filter((term) => /^assets\/app-data\/story\//u.test(term)),
  };
}

const clientEntries = model.sections.flatMap((section) => section.paths.flatMap((storyPath) => storyPath.entries.map((entry) => {
  const characterIds = entry.text?.characterIds?.length ? entry.text.characterIds : storyPath.characterIds;
  return compactEntry(entry, storyPath.title, storyPath.sectionLabel, section.act, characterIds);
})));
const clientScenes = model.sections.flatMap((section) => section.paths.flatMap((storyPath) => storyPath.pathScenes.map((scene) => compactScene(scene, storyPath.title, storyPath.sectionLabel, section.act))));
const storyResourceList = [...new Map(model.paths.flatMap((storyPath) => [
  ...storyPath.entries.flatMap((entry) => entry.resources),
  ...storyPath.pathScenes.flatMap((scene) => scene.resources),
]).concat(model.unassignedResources).map((resource) => [resource.resourceId, resource])).values()];
const clientResources = Object.fromEntries(storyResourceList.map((resource) => [resource.resourceId, compactResource(resource)]));
const clientPayload = {
  entries: clientEntries,
  scenes: clientScenes,
  resources: clientResources,
  subworlds: finaleLayout
    ? [{
      id: "final-verdict",
      title: "Final Verdict",
      sectionAct: 2,
      nodeKeys: finaleLayout.subworld.nodes.map((node) => node.nodeKey),
      continuationKeys: finaleLayout.continuation?.continuation.nodes.map((node) => node.nodeId) ?? [],
    }]
    : [],
};
const safeJson = (value: unknown): string => JSON.stringify(value).replaceAll("<", "\\u003c");

function imageAttributes(image: PublicAsset | undefined, active: boolean): Record<string, string | number> {
  if (!image) return {};
  return active ? { src: image.url, width: image.width, height: image.height } : { "data-src": image.url, width: image.width, height: image.height };
}

function authoredLabelStyle(point: { x: number; y: number }, label: StoryAtlasNodeLabel): string {
  return [
    "--story-label-offset-x:" + (label.x - point.x) + "px",
    "--story-label-offset-y:" + (label.y - point.y) + "px",
    "--story-label-width:" + label.width + "px",
    "--story-label-height:" + label.height + "px",
    "--story-label-anchor-x:" + label.anchorX,
    "--story-label-anchor-y:" + label.anchorY,
    "--story-label-scale-x:" + label.scaleX,
    "--story-label-scale-y:" + label.scaleY,
    "--story-label-rotation:" + label.rotation + "deg",
    "--story-label-font-size:" + (label.fontSize ?? 18) + "px",
    "--story-label-text-align:" + (label.horizontalAlignment ?? "center"),
    "--story-label-justify-items:" + (label.horizontalAlignment === "left" ? "start" : label.horizontalAlignment === "right" ? "end" : "center"),
    "--story-label-align-items:" + (label.verticalAlignment === "top" ? "start" : label.verticalAlignment === "bottom" ? "end" : "center"),
  ].join(";") + ";";
}

---

<section class="story-atlas-shell" aria-label="Arcaea 剧情图谱" data-story-atlas-root data-story-atlas-url={sitePath("/data/story/arcaea.json", BASE_PATH)} data-base-path={BASE_PATH}>
  <div class="story-atlas-toolbar">
    <div class="story-atlas-view-switch" role="group" aria-label="剧情浏览模式">
      <button class="button button-primary" type="button" data-story-view-toggle="atlas" aria-pressed="true">剧情图谱</button>
      <button class="button button-secondary" type="button" data-story-view-toggle="gallery" aria-pressed="false">图库</button>
    </div>
    <label class="story-atlas-search">
      <span class="sr-only">搜索剧情节点、章节或角色</span>
      <input type="search" data-story-search placeholder="搜索剧情节点、章节或角色……" autocomplete="off" />
    </label>
    <span class="story-atlas-search-status" data-story-search-status aria-live="polite"></span>
  </div>
  <div class="story-atlas-search-results" data-story-search-results hidden></div>

  <nav class="story-atlas-parts" data-story-part-tabs aria-label="章节">
    {model.sections.map((section, index) => {
      const artwork = sectionArtwork(section.label);
      const parts = sectionParts(section.label);
      return <button class:list={{ "story-atlas-part-tab": true, "is-active": index === 0 }} type="button" role="tab" data-story-section={section.act} aria-selected={index === 0} aria-controls={"story-atlas-section-" + section.act}>
        {artwork ? <img {...imageAttributes(artwork, true)} alt="" decoding="async" /> : null}
        <span><small>{parts.act}</small><strong>{parts.part}</strong>{section.resourceCount > 0 ? <em>{section.resourceCount} 个视觉资源</em> : null}</span>
      </button>;
    })}
  </nav>

  <div class="story-atlas-panels" data-story-panels>
    {model.sections.map((section, index) => {
      const layout = layouts.get(section.act);
      const active = index === 0;
      const parts = sectionParts(section.label);
      const backdrop = storyUiAsset("act-bg.jpg");
      const divider = storyUiAsset("story_pack_divider_horizontal.png");
      const titleBacking = storyUiAsset("act-title-backing.png");
      if (!layout) return null;
      return <section class:list={{ "story-atlas-section": true, "is-active": active }} id={"story-atlas-section-" + section.act} data-story-section-panel={section.act} role="tabpanel" aria-label={section.label} hidden={!active}>
        <header class="story-atlas-section-heading">
          <div class="story-atlas-section-title" style={titleBacking ? "--story-title-backing: url('" + titleBacking.url + "')" : undefined}>
            <span class="story-atlas-section-act">{parts.act}</span>
            <h3>{parts.part}</h3>
          </div>
          <div class="story-camera-controls" role="group" aria-label="剧情地图视角">
            <button type="button" class="icon-button" data-story-camera="zoom-out" aria-label="缩小">−</button>
            <button type="button" class="icon-button" data-story-camera="zoom-in" aria-label="放大">＋</button>
            <button type="button" class="button button-secondary" data-story-camera="fit">总览</button>
            <button type="button" class="button button-secondary" data-story-camera="initial">初始视角</button>
          </div>
        </header>
        <div class="story-map-viewport" data-story-map-viewport tabindex="0" aria-label={section.label + " 剧情地图"} data-world-width={layout.width} data-world-height={layout.height} data-story-initial-x={layout.initialCamera.x} data-story-initial-y={layout.initialCamera.y} data-story-initial-scale={layout.initialCamera.scale}>
          <div class="story-map-world" data-story-map-world data-story-world-source={layout.layoutSource} style={"width:" + layout.width + "px;height:" + layout.height + "px;"}>
            {backdrop ? <img class="story-map-background" {...imageAttributes(backdrop, active)} alt="" decoding="async" /> : null}
            <div class="story-map-wash" aria-hidden="true"></div>
            <div class="story-map-grid" aria-hidden="true"></div>
            <svg class="story-map-links" viewBox={"0 0 " + layout.width + " " + layout.height} role="presentation" aria-hidden="true">
              {layout.lines.map((line) => <line class:list={{ "story-map-link": true, "is-authored": line.provenance === "authored-csb", "is-fallback": line.provenance === "sequential-fallback", "is-external": line.external === true }} x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} stroke-width={line.thickness} data-story-link-from={line.from} data-story-link-to={line.to} data-story-link-path-ids={line.pathIds.join(",")} data-story-link-provenance={line.provenance} />)}
            </svg>
            <div class="story-map-paths">
              {layout.paths.map((pathLayout) => {
                const pathTitle = pathLayout.title ?? { x: pathLayout.x + pathLayout.width / 2, y: pathLayout.y + 30 };
                return <section class:list={{ "story-map-path-cluster": true, "is-active": pathLayout.path.pathId === firstPath?.pathId }} data-story-map-path={pathLayout.path.pathId} data-story-path-x={pathTitle.x} data-story-path-y={pathTitle.y} style={"left:" + pathLayout.x + "px;top:" + pathLayout.y + "px;width:" + pathLayout.width + "px;height:" + pathLayout.height + "px;"}>
                  <button class="story-map-path-title" type="button" data-story-path={pathLayout.path.pathId} data-story-path-section={section.act} data-story-x={pathTitle.x} data-story-y={pathTitle.y} style={"left:" + (pathTitle.x - pathLayout.x) + "px;top:" + (pathTitle.y - pathLayout.y) + "px;"} aria-label={"定位 " + pathLayout.path.title + " 路径"}>
                    <strong style={pathLayout.titleLabel ? authoredLabelStyle(pathTitle, pathLayout.titleLabel) : undefined}>{pathLayout.path.title}</strong>
                  </button>
                  <div class="story-map-avatars">
                    {pathLayout.avatars.map((avatar) => {
                      const image = avatarImage(avatar.id);
                      return <button class="story-map-avatar" type="button" data-story-avatar data-story-cluster-path={pathLayout.path.pathId} data-story-section={section.act} data-story-x={avatar.x} data-story-y={avatar.y} style={"left:" + (avatar.x - pathLayout.x) + "px;top:" + (avatar.y - pathLayout.y) + "px;--story-avatar-width:" + avatar.width + "px;--story-avatar-height:" + avatar.height + "px;--story-avatar-scale-x:" + avatar.scaleX + ";--story-avatar-scale-y:" + avatar.scaleY + ";--story-avatar-anchor-x:" + avatar.anchorX + ";--story-avatar-anchor-y:" + avatar.anchorY + ";--story-avatar-rotation:" + avatar.rotation + "deg;"} aria-label={"定位 " + avatarLabel(avatar.id)} title={avatarLabel(avatar.id)}>
                        {image ? <img {...imageAttributes(image, active)} alt={avatarLabel(avatar.id)} decoding="async" /> : <span class="story-map-avatar-fallback">{avatarLabel(avatar.id)}</span>}
                      </button>;
                    })}
                  </div>
                  <div class:list={{ "story-map-node-route": true, ["is-" + pathLayout.orientation]: true }}>
                    {pathLayout.path.entries.map((entry) => {
                      const point = pathLayout.nodes[entry.key];
                      const transform = pathLayout.nodeTransforms[entry.key];
                      const image = nodeImage(entry);
                      if (!point || !transform) return null;
                      return <button class:list={{ "story-map-node": true, "has-cg": entry.resources.length > 0, "has-scene": entry.sceneIds.length > 0, "is-active": entry.key === firstEntry?.key && pathLayout.path.pathId === firstPath?.pathId }} type="button" data-story-map-entry data-story-node-variant={/^VS-/u.test(entry.key) ? "vs" : /^F-/u.test(entry.key) ? "finale" : /^(?:V|E)-/u.test(entry.key) ? "special" : "standard"} data-story-path-id={entry.pathId} data-story-entry-key={entry.key} data-story-x={point.x} data-story-y={point.y} style={"left:" + (point.x - pathLayout.x) + "px;top:" + (point.y - pathLayout.y) + "px;--story-node-width:" + transform.width + "px;--story-node-height:" + transform.height + "px;--story-node-scale-x:" + transform.scaleX + ";--story-node-scale-y:" + transform.scaleY + ";--story-node-rotation:" + transform.rotation + "deg;"} aria-label={pathLayout.path.title + " Entry " + entry.key} aria-controls="story-story-dialog">
                        {image ? <img class="story-map-node-image" {...imageAttributes(image, active)} alt="" decoding="async" /> : <span class="story-map-node-fallback">?</span>}
                        {transform.labelMode === "overlay" ? <span class="story-map-node-label" style={transform.label ? authoredLabelStyle(point, transform.label) : undefined}>{entry.key}</span> : null}
                        {entry.resources.length > 0 ? <span class="story-map-node-count">{entry.resources.length}</span> : null}
                      </button>;
                    })}
                  </div>
                  {pathLayout.scenes.map((scene) => {
                    const source = pathLayout.path.pathScenes.find((candidate) => candidate.sceneId === scene.sceneId);
                    const isUnassignedCg = source?.isUnassignedCg === true;
                    const image = isUnassignedCg && source?.resources[0] ? resourceImage(source.resources[0]) : undefined;
                    return <button class:list={{ "story-map-scene": true, "story-map-unassigned-cg": isUnassignedCg }} type="button" data-story-scene={scene.sceneId} data-story-path-id={pathLayout.path.pathId} data-story-section={section.act} data-story-x={scene.x} data-story-y={scene.y} style={"left:" + (scene.x - pathLayout.x) + "px;top:" + (scene.y - pathLayout.y) + "px;"} aria-label={isUnassignedCg ? pathLayout.path.title + " 未归类 CG" : scene.title} aria-controls="story-story-dialog">
                      {isUnassignedCg ? <>
                        {image ? <img {...imageAttributes(image, active)} alt="" decoding="async" /> : null}
                        <strong>未归类 CG</strong><small>{source?.resources.length ?? 0} 张</small>
                      </> : <>
                        <span class="story-map-scene-mark">+</span><span>{scene.title}</span><small>场景</small>
                      </>}
                    </button>;
                  })}
                  <div class="story-map-path-divider" style={divider ? "--story-divider: url('" + divider.url + "')" : undefined} aria-hidden="true"></div>
                </section>;
              })}
            </div>
            {layout.portals.map((portal) => {
              const image = storyUiAsset("finale-portal-default.png") ?? derivativeUi("entry_finaleOpen.png");
              return <button class="story-map-portal" type="button" data-story-portal="final-verdict" data-story-subworld="final-verdict" data-story-section={section.act} data-story-x={portal.x} data-story-y={portal.y} style={"left:" + portal.x + "px;top:" + portal.y + "px;--story-portal-width:" + portal.width + "px;--story-portal-height:" + portal.height + "px;--story-portal-scale-x:" + portal.scaleX + ";--story-portal-scale-y:" + portal.scaleY + ";--story-portal-rotation:" + portal.rotation + "deg;"} aria-label="进入 Final Verdict">
                {image ? <img {...imageAttributes(image, active)} alt="" decoding="async" /> : <span>Final Verdict</span>}
                <strong>进入 Final Verdict</strong>
              </button>;
            })}
          </div>
        </div>
      </section>;
    })}
  </div>
  {finaleLayout ? <section class="story-atlas-subworld" data-story-subworld-panel="final-verdict" hidden aria-label="Final Verdict">
    <header class="story-atlas-subworld-heading">
      <div>
        <span class="story-atlas-section-act">Act I · Part III</span>
        <h3>Final Verdict</h3>
        <p>探索最终章节的连续路径。</p>
      </div>
      <div class="story-camera-controls">
        <button type="button" class="icon-button" data-story-camera="zoom-out" aria-label="缩小">−</button>
        <button type="button" class="icon-button" data-story-camera="zoom-in" aria-label="放大">＋</button>
        <button type="button" class="button button-secondary" data-story-camera="fit">总览</button>
        <button type="button" class="button button-secondary" data-story-camera="initial">初始视角</button>
        <button type="button" class="button button-secondary" data-story-subworld-back>返回 Part III</button>
      </div>
    </header>
    <div class="story-map-viewport story-map-viewport-subworld" data-story-map-viewport data-story-subworld-viewport data-story-subworld-id="final-verdict" tabindex="0" aria-label="Final Verdict 剧情地图" data-world-width={finaleLayout.width} data-world-height={finaleLayout.height} data-story-initial-x={finaleLayout.initialCamera.x} data-story-initial-y={finaleLayout.initialCamera.y} data-story-initial-scale={finaleLayout.initialCamera.scale}>
      <div class="story-map-world story-map-world-subworld" data-story-map-world style={"width:" + finaleLayout.width + "px;height:" + finaleLayout.height + "px;"}>
        <div class="story-map-wash" aria-hidden="true"></div>
        <div class="story-map-grid" aria-hidden="true"></div>
        <svg class="story-map-links" viewBox={"0 0 " + finaleLayout.width + " " + finaleLayout.height} role="presentation" aria-hidden="true">
          {finaleLayout.lines.map((line) => <line class:list={{ "story-map-link": true, "is-authored": true }} x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} stroke-width={line.thickness} data-story-link-from={line.from} data-story-link-to={line.to} data-story-link-path-ids={line.pathIds.join(",")} data-story-link-provenance={line.provenance} />)}
        </svg>
        <div class="story-map-subworld-title" style={"left:" + finaleLayout.title.x + "px;top:" + finaleLayout.title.y + "px;"}>Final Verdict</div>
        <div class="story-map-subworld-nodes">
          {finaleLayout.subworld.nodes.map((authoredNode) => {
            const point = finaleLayout.nodes[authoredNode.nodeKey];
            const transform = finaleLayout.nodeTransforms[authoredNode.nodeKey];
            const entry = finalVerdictPath?.entries.find((candidate) => candidate.key === authoredNode.nodeKey);
            const image = entry ? nodeImage(entry) : derivativeUi("finale-" + authoredNode.nodeKey.slice(2) + ".png");
            if (!point || !transform) return null;
            return <button class="story-map-node story-map-node-finale" type="button" data-story-map-entry data-story-subworld-node data-story-subworld-id="final-verdict" data-story-node-variant="finale" data-story-path-id="19" data-story-entry-key={authoredNode.nodeKey} data-story-x={point.x} data-story-y={point.y} style={"left:" + point.x + "px;top:" + point.y + "px;--story-node-width:" + transform.width + "px;--story-node-height:" + transform.height + "px;--story-node-scale-x:" + transform.scaleX + ";--story-node-scale-y:" + transform.scaleY + ";--story-node-rotation:" + transform.rotation + "deg;"} aria-label={"Final Verdict Entry " + authoredNode.nodeKey} aria-controls="story-story-dialog">
              {image ? <img class="story-map-node-image" {...imageAttributes(image, true)} alt="" decoding="async" /> : <span class="story-map-node-fallback">?</span>}
              {transform.labelMode === "overlay" ? <span class="story-map-node-label" style={transform.label ? authoredLabelStyle(point, transform.label) : undefined}>{authoredNode.nodeKey}</span> : null}
            </button>;
          })}
          {finaleLayout.continuation?.continuation.nodes.map((node) => {
            const point = finaleLayout.continuation?.nodes[node.nodeId];
            const transform = finaleLayout.continuation?.nodeTransforms[node.nodeId];
            const entryKey = node.nodeId === "epilogue_a" ? "E-1" : "E-2";
            const image = continuationImage(node.nodeId);
            if (!point || !transform) return null;
            return <button class="story-map-node story-map-node-ending" type="button" data-story-map-entry data-story-subworld-node data-story-subworld-id="final-verdict" data-story-node-variant="ending" data-story-path-id="19" data-story-entry-key={entryKey} data-story-x={point.x} data-story-y={point.y} style={"left:" + point.x + "px;top:" + point.y + "px;--story-node-width:" + transform.width + "px;--story-node-height:" + transform.height + "px;--story-node-scale-x:" + transform.scaleX + ";--story-node-scale-y:" + transform.scaleY + ";--story-node-rotation:" + transform.rotation + "deg;"} aria-label={"Final Verdict Entry " + entryKey + " " + (node.label ?? entryKey)} aria-controls="story-story-dialog">
              {image ? <img class="story-map-node-image" {...imageAttributes(image, true)} alt="" decoding="async" /> : <span class="story-map-node-fallback">?</span>}
              {transform.labelMode === "overlay" ? <span class="story-map-node-label" style={transform.label ? authoredLabelStyle(point, transform.label) : undefined}>{node.label ?? entryKey}</span> : null}
            </button>;
          })}
          {finalUnassignedCg && finaleLayout.unassignedCg ? <button class="story-map-scene story-map-unassigned-cg story-map-subworld-unassigned-cg" type="button" data-story-scene={finalUnassignedCg.sceneId} data-story-path-id="19" data-story-section="2" data-story-x={finaleLayout.unassignedCg.point.x} data-story-y={finaleLayout.unassignedCg.point.y} style={"left:" + finaleLayout.unassignedCg.point.x + "px;top:" + finaleLayout.unassignedCg.point.y + "px;"} aria-label="Final Verdict 未归类 CG" aria-controls="story-story-dialog">
             {finalUnassignedCg.resources[0] ? <img {...imageAttributes(resourceImage(finalUnassignedCg.resources[0]), true)} alt="" decoding="async" /> : null}
             <strong>未归类 CG</strong><small>{finalUnassignedCg.resources.length} 张</small>
           </button> : null}
        </div>
      </div>
    </div>
  </section> : null}

  <aside class="story-detail-dialog" id="story-story-dialog" data-story-detail hidden aria-labelledby="story-detail-heading" aria-describedby="story-detail-summary" aria-modal="true" role="dialog">
    <div class="story-detail-backdrop" data-story-detail-close aria-hidden="true"></div>
    <div class="story-detail-sheet">
      <button class="story-detail-close" type="button" data-story-detail-close aria-label="关闭剧情">×</button>
      <div class="story-detail-content" data-story-detail-content>
        {firstEntry ? <>
          <div class="story-detail-eyebrow">{firstEntry.key}</div>
          <h3 id="story-detail-heading">{firstPath?.title}</h3>
          <p class="story-detail-path" id="story-detail-summary">路径：{firstPath?.title} · {firstPath?.sectionLabel}</p>
          <div class="story-detail-meta">
            {firstPath?.characterIds.length ? <div><dt>角色</dt><dd>{firstPath.characterIds.map(avatarLabel).join(" / ")}</dd></div> : null}
            {firstEntry.relatedSongs.length ? <div><dt>相关歌曲</dt><dd>{firstEntry.relatedSongs.join(" / ")}</dd></div> : null}
          </div>
          <p class="story-detail-empty">点击地图中的节点查看完整剧情。</p>
        </> : <p>请选择一个剧情节点。</p>}
      </div>
    </div>
  </aside>

  <script is:inline type="application/json" data-story-atlas-client-index set:html={safeJson(clientPayload)}></script>
  <script src="../scripts/arcaea-story-atlas.ts"></script>
</section>
