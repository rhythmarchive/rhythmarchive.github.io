---
import BrowseCard from "./BrowseCard.astro";
import RangeHistogram from "./RangeHistogram.astro";
import GalleryFilters from "./GalleryFilters.astro";
import BatchTray from "./BatchTray.astro";
import GalleryLoadError from "./GalleryLoadError.astro";
import GalleryDownload from "./GalleryDownload.astro";
import { getBrowseFacetOptions, getBrowseSortOptions, browseDifficultyHistogram, type ArcaeaFacetOptions, type BrowseGalleryData, type InfalsusFacetOptions, type PhigrosFacetOptions, type RizlineFacetOptions } from "../lib/browse-gallery";
import { formatCount } from "../lib/format";
import { displayFilterDifficultyLabel } from "../lib/game-config";
import { BASE_PATH } from "../lib/site-config";
import { cardFrameForPreviews } from "../lib/card-frame";

interface Props {
  data: BrowseGalleryData;
  categoryLabel: string;
  galleryUrl: string;
}

const { data, categoryLabel, galleryUrl } = Astro.props;
const initialItems = data.items.slice(0, 48);
const cardFrame = cardFrameForPreviews(data.items.map((item) => item.preview));
const hasUpscale = data.items.some((item) => item.hasUpscaled);
const searchPlaceholder = data.game === "rizline" ? "搜索曲名、曲师或画师" : "搜索曲名或曲师";
const browseOptions = getBrowseFacetOptions(data);
const arcaeaOptions = data.game === "arcaea" ? browseOptions as ArcaeaFacetOptions : undefined;
const phigrosOptions = data.game === "phigros" ? browseOptions as PhigrosFacetOptions : undefined;
const rizlineOptions = data.game === "rizline" ? browseOptions as RizlineFacetOptions : undefined;
const infalsusOptions = data.game === "infalsus" ? browseOptions as InfalsusFacetOptions : undefined;
const phigrosPackOptions = phigrosOptions?.packs ?? [];
const difficultyRange = browseOptions.difficultyRange;
const difficultyLabel = "谱面定数";
const difficultyHistogram = difficultyRange ? browseDifficultyHistogram(data, difficultyRange) : undefined;

function rangeTicks(min: number, max: number, step: number): number[] {
  const tickStep = Math.max(step, Math.ceil(((max - min) / 7) / step) * step);
  const values = [min];
  for (let value = min + tickStep; value < max - step / 2; value += tickStep) values.push(Number(value.toFixed(1)));
  if (values[values.length - 1] !== max) values.push(max);
  return values;
}

function formatRangeValue(value: number): string {
  return value.toFixed(1);
}
---

<section class="gallery-shell browse-gallery-shell has-filters" data-browse-gallery-root data-gallery-url={galleryUrl} data-batch-url={galleryUrl.replace("/browse/", "/batch/")} data-base-path={BASE_PATH} data-game={data.game} data-category="jacket" data-total={data.items.length}>
  <script is:inline data-astro-rerun>
    document.currentScript?.closest("[data-browse-gallery-root]")?.setAttribute("aria-busy", "true");
  </script>
  {Astro.slots.has("heading") ? <div class="gallery-content-heading"><slot name="heading" /></div> : null}
  <div class="gallery-toolbar browse-gallery-toolbar">
    <div class="gallery-toolbar-copy">
      <span class="section-kicker">{categoryLabel}</span>
      <p data-gallery-count aria-hidden="true">{formatCount(data.items.length)} 项资源</p>
    </div>
    <div class="gallery-toolbar-controls">
      {(data.game === "arcaea" && arcaeaOptions) || data.game === "phigros" || (data.game === "rizline" && rizlineOptions) || (data.game === "infalsus" && infalsusOptions) ? <button class="button button-secondary gallery-filter-open" type="button" data-filter-open aria-haspopup="dialog" aria-controls={`browse-filters-${data.game}`}>筛选 <span data-filter-summary></span></button> : null}
      <label class="gallery-search">
        <span class="sr-only">{searchPlaceholder}</span>
        <svg class="gallery-search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg>
        <input type="search" data-browse-search placeholder={searchPlaceholder} autocomplete="off" />
      </label>
      <label class="sort-control">
        <span>排序</span>
        <select data-browse-sort aria-label="排序">
          {getBrowseSortOptions(data).map(option => <option value={option.value}>{option.label}</option>)}
        </select>
      </label>
    </div>
  </div>

  <div class="gallery-results-bar"><span data-gallery-result-count role="status" aria-live="polite" aria-atomic="true">{formatCount(data.items.length)} 项资源</span><GalleryDownload id={`browse-download-${data.game}`} /></div>

  {(data.game === "arcaea" && arcaeaOptions) || data.game === "phigros" || (data.game === "rizline" && rizlineOptions) || (data.game === "infalsus" && infalsusOptions) ? (
    <GalleryFilters id={`browse-filters-${data.game}`}>
  <div class="active-filter-row" data-browse-active hidden>
    <span class="active-filter-label">当前筛选</span>
    <div class="active-filter-chips" data-browse-active-chips></div>
    <button class="text-link" type="button" data-gallery-reset>清除全部</button>
  </div>
  {difficultyRange ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      <div class="filter-range-control" data-browse-range="difficulty" data-range-label={difficultyLabel} data-range-min={difficultyRange.min} data-range-max={difficultyRange.max} data-range-step={difficultyRange.step}>
        <div class="filter-range-header">
          <span class="filter-range-label">{difficultyLabel}</span>
          <div class="filter-range-values" role="group" aria-label={`${difficultyLabel}范围`}>
            <label class="filter-range-input"><span class="sr-only">{difficultyLabel}最小值</span><input type="number" data-browse-range-min-input min={difficultyRange.min} max={difficultyRange.max} step={difficultyRange.step} value={difficultyRange.min} inputmode="decimal" /></label>
            <span aria-hidden="true">～</span>
            <label class="filter-range-input"><span class="sr-only">{difficultyLabel}最大值</span><input type="number" data-browse-range-max-input min={difficultyRange.min} max={difficultyRange.max} step={difficultyRange.step} value={difficultyRange.max} inputmode="decimal" /></label>
          </div>
        </div>
        <RangeHistogram histogram={difficultyHistogram} min={difficultyRange.min} max={difficultyRange.max} label={difficultyLabel} />
        <div class="filter-range-slider" data-browse-range-slider>
          <div class="filter-range-track" aria-hidden="true"></div>
          <div class="filter-range-fill" aria-hidden="true"></div>
          <input type="range" data-browse-range-min-slider min={difficultyRange.min} max={difficultyRange.max} step={difficultyRange.step} value={difficultyRange.min} aria-label={`${difficultyLabel}最小值`} />
          <input type="range" data-browse-range-max-slider min={difficultyRange.min} max={difficultyRange.max} step={difficultyRange.step} value={difficultyRange.max} aria-label={`${difficultyLabel}最大值`} />
        </div>
        <div class="filter-range-ticks" aria-hidden="true">{rangeTicks(difficultyRange.min, difficultyRange.max, difficultyRange.step).map((value) => <span>{formatRangeValue(value)}</span>)}</div>
      </div>
    </div>
  ) : null}
  {data.game === "arcaea" && arcaeaOptions ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      <label class="filter-control"><span>难度</span><select data-browse-filter-select="chart" aria-label="难度"><option value="">全部</option>{arcaeaOptions.charts.map((value) => <option value={value}>{displayFilterDifficultyLabel(value, "arcaea")}</option>)}</select></label>
      <label class="filter-control"><span>曲包</span><select data-browse-filter-select="pack" aria-label="曲包"><option value="">全部</option>{arcaeaOptions.packs.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="filter-control"><span>加入版本</span><select data-browse-filter-select="version" aria-label="加入版本"><option value="">全部</option>{arcaeaOptions.versions.map((value) => <option value={value}>{value}</option>)}</select></label>
      {hasUpscale ? <label class="filter-check"><input type="checkbox" data-filter-ai /> <span>含超分版</span></label> : null}
    </div>
  ) : data.game === "phigros" ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      {phigrosOptions?.charts.length ? <label class="filter-control"><span>谱面难度</span><select data-browse-filter-select="chart" aria-label="谱面难度"><option value="">全部</option>{phigrosOptions.charts.map((value) => <option value={value}>{displayFilterDifficultyLabel(value, "phigros")}</option>)}</select></label> : null}
      {phigrosPackOptions.length > 0 ? <label class="filter-control"><span>曲包</span><select data-browse-filter-select="pack" aria-label="曲包"><option value="">全部</option>{phigrosPackOptions.map((value) => <option value={value}>{value}</option>)}</select></label> : null}
    </div>
  ) : data.game === "rizline" && rizlineOptions ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      {rizlineOptions.charts.length > 0 ? <label class="filter-control"><span>谱面难度</span><select data-browse-filter-select="chart" aria-label="谱面难度"><option value="">全部</option>{rizlineOptions.charts.map((value) => <option value={value}>{value}</option>)}</select></label> : null}
      <label class="filter-control"><span>Disc</span><select data-browse-filter-select="disc" aria-label="Disc"><option value="">全部</option>{rizlineOptions.discs.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="filter-control"><span>精选集</span><select data-browse-filter-select="series" aria-label="精选集"><option value="">全部</option>{rizlineOptions.trackSeries.map((value) => <option value={value}>{value}</option>)}</select></label>
    </div>
  ) : data.game === "infalsus" && infalsusOptions ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      <label class="filter-control"><span>谱面难度</span><select data-browse-filter-select="chart" aria-label="谱面难度"><option value="">全部</option>{infalsusOptions.charts.map((value) => <option value={value}>{value}</option>)}</select></label>
    </div>
  ) : null}

    </GalleryFilters>
  ) : null}



  <GalleryLoadError />
  <div class="gallery-grid" data-gallery-grid data-card-frame={cardFrame}>
    {initialItems.map((item, index) => <BrowseCard item={item} selectable eager={index < 6} />)}
  </div>
  <div class="gallery-empty" data-browse-empty hidden>
    <p>没有找到符合条件的资源</p>
    <button class="button button-secondary" type="button" data-browse-empty-reset>清除全部</button>
  </div>

  <div class="gallery-more">
    <button class="button button-secondary" type="button" data-load-more hidden={initialItems.length >= data.items.length}>加载更多</button>
  </div>

  <BatchTray />
</section>

<script src="../scripts/browse-gallery.ts"></script>
