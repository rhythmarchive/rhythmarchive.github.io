---
import BrowseCard from "./BrowseCard.astro";
import { getBrowseFacetOptions, type ArcaeaFacetOptions, type BrowseGalleryData, type InfalsusFacetOptions, type PhigrosFacetOptions, type RizlineFacetOptions } from "../lib/browse-gallery";
import { formatCount } from "../lib/format";
import { displayFilterDifficultyLabel } from "../lib/game-config";
import { BASE_PATH } from "../lib/site-config";

interface Props {
  data: BrowseGalleryData;
  categoryLabel: string;
  galleryUrl: string;
}

const { data, categoryLabel, galleryUrl } = Astro.props;
const initialItems = data.items.slice(0, 48);
const hasUpscale = data.items.some((item) => item.hasUpscaled);
const searchPlaceholder = data.game === "rizline" ? "搜索曲名、曲师或画师" : "搜索曲名或曲师";
const browseOptions = getBrowseFacetOptions(data);
const arcaeaOptions = data.game === "arcaea" ? browseOptions as ArcaeaFacetOptions : undefined;
const phigrosOptions = data.game === "phigros" ? browseOptions as PhigrosFacetOptions : undefined;
const rizlineOptions = data.game === "rizline" ? browseOptions as RizlineFacetOptions : undefined;
const infalsusOptions = data.game === "infalsus" ? browseOptions as InfalsusFacetOptions : undefined;
const phigrosPackOptions = phigrosOptions?.packs ?? [];
const phigrosLevelOptions = phigrosOptions?.levels ?? [];
const phigrosDifficultyRange = phigrosOptions?.difficultyRange;

function rangeTicks(min: number, max: number, step: number): number[] {
  const tickStep = Math.max(step, Math.ceil(((max - min) / 7) / step) * step);
  const values = [min];
  for (let value = min + tickStep; value < max - step / 2; value += tickStep) values.push(Number(value.toFixed(1)));
  if (values[values.length - 1] !== max) values.push(max);
  return values;
}

function formatRangeValue(value: number): string {
  return value.toFixed(1);
}
---

<section class="gallery-shell browse-gallery-shell" data-browse-gallery-root data-gallery-url={galleryUrl} data-base-path={BASE_PATH} data-game={data.game} data-category="jacket" data-total={data.items.length}>
  <div class="gallery-toolbar browse-gallery-toolbar">
    <div class="gallery-toolbar-copy">
      <span class="section-kicker">{categoryLabel}</span>
      <p data-gallery-count>{formatCount(data.items.length)} 项资源</p>
    </div>
    <div class="gallery-toolbar-controls">
      <label class="gallery-search">
        <span class="sr-only">{searchPlaceholder}</span>
        <input type="search" data-browse-search placeholder={searchPlaceholder} autocomplete="off" />
      </label>
      <label class="sort-control">
        <span>排序</span>
        <select data-browse-sort aria-label="排序">
          {data.game === "arcaea" ? (
            <>
              <option value="default">游戏顺序</option>
              <option value="title-asc">曲名 A-Z</option>
              <option value="title-desc">曲名 Z-A</option>
              <option value="artist-asc">曲师 A-Z</option>
              <option value="artist-desc">曲师 Z-A</option>
              <option value="version-desc">版本从新到旧</option>
              <option value="version-asc">版本从旧到新</option>
            </>
          ) : (
            <>
              <option value="default">默认排序</option>
              <option value="title-asc">曲名 A-Z</option>
              <option value="title-desc">曲名 Z-A</option>
              <option value="artist-asc">曲师 A-Z</option>
              <option value="artist-desc">曲师 Z-A</option>
              {data.game === "phigros" ? <><option value="pack-asc">曲包 A-Z</option><option value="pack-desc">曲包 Z-A</option><option value="level-desc">最高难度高 → 低</option><option value="level-asc">最高难度低 → 高</option></> : null}
            </>
          )}
        </select>
      </label>
    </div>
  </div>

  {data.game === "arcaea" && arcaeaOptions ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      <label class="filter-control"><span>难度</span><select data-browse-filter-select="chart" aria-label="难度"><option value="">全部</option>{arcaeaOptions.charts.map((value) => <option value={value}>{displayFilterDifficultyLabel(value, "arcaea")}</option>)}</select></label>
      <label class="filter-control"><span>曲包</span><select data-browse-filter-select="pack" aria-label="曲包"><option value="">全部</option>{arcaeaOptions.packs.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="filter-control"><span>等级</span><select data-browse-filter-select="level" aria-label="等级"><option value="">全部</option>{arcaeaOptions.levels.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="filter-control"><span>加入版本</span><select data-browse-filter-select="version" aria-label="加入版本"><option value="">全部</option>{arcaeaOptions.versions.map((value) => <option value={value}>{value}</option>)}</select></label>
      {hasUpscale ? <label class="filter-check"><input type="checkbox" data-filter-ai /> <span>含超分版</span></label> : null}
    </div>
  ) : data.game === "phigros" ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      {phigrosDifficultyRange ? (
        <div class="filter-range-control" data-browse-range="difficulty" data-range-label="难度" data-range-min={phigrosDifficultyRange.min} data-range-max={phigrosDifficultyRange.max} data-range-step={phigrosDifficultyRange.step}>
          <div class="filter-range-header">
            <span class="filter-range-label">难度</span>
            <div class="filter-range-values" role="group" aria-label="难度范围">
              <label class="filter-range-input"><span class="sr-only">难度最小值</span><input type="number" data-browse-range-min-input min={phigrosDifficultyRange.min} max={phigrosDifficultyRange.max} step={phigrosDifficultyRange.step} value={phigrosDifficultyRange.min} inputmode="decimal" /></label>
              <span aria-hidden="true">～</span>
              <label class="filter-range-input"><span class="sr-only">难度最大值</span><input type="number" data-browse-range-max-input min={phigrosDifficultyRange.min} max={phigrosDifficultyRange.max} step={phigrosDifficultyRange.step} value={phigrosDifficultyRange.max} inputmode="decimal" /></label>
            </div>
          </div>
          <div class="filter-range-slider" data-browse-range-slider>
            <div class="filter-range-track" aria-hidden="true"></div>
            <div class="filter-range-fill" aria-hidden="true"></div>
            <input type="range" data-browse-range-min-slider min={phigrosDifficultyRange.min} max={phigrosDifficultyRange.max} step={phigrosDifficultyRange.step} value={phigrosDifficultyRange.min} aria-label="难度最小值" />
            <input type="range" data-browse-range-max-slider min={phigrosDifficultyRange.min} max={phigrosDifficultyRange.max} step={phigrosDifficultyRange.step} value={phigrosDifficultyRange.max} aria-label="难度最大值" />
          </div>
          <div class="filter-range-ticks" aria-hidden="true">{rangeTicks(phigrosDifficultyRange.min, phigrosDifficultyRange.max, phigrosDifficultyRange.step).map((value) => <span>{formatRangeValue(value)}</span>)}</div>
        </div>
      ) : null}
      {phigrosLevelOptions.length > 0 ? (
        <label class="filter-control">
          <span>难度等级</span>
          <select data-browse-filter-select="level" data-browse-level aria-label="难度等级">
            <option value="">全部</option>
            {phigrosLevelOptions.map((level) => <option value={level}>{level}</option>)}
          </select>
        </label>
      ) : null}
      {phigrosPackOptions.length > 0 ? <label class="filter-control"><span>曲包</span><select data-browse-filter-select="pack" aria-label="曲包"><option value="">全部</option>{phigrosPackOptions.map((value) => <option value={value}>{value}</option>)}</select></label> : null}
    </div>
  ) : data.game === "rizline" && rizlineOptions ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      <label class="filter-control"><span>谱面难度</span><select data-browse-filter-select="chart" aria-label="谱面难度"><option value="">全部</option>{rizlineOptions.charts.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="filter-control"><span>Disc</span><select data-browse-filter-select="disc" aria-label="Disc"><option value="">全部</option>{rizlineOptions.discs.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="filter-control"><span>精选集</span><select data-browse-filter-select="series" aria-label="精选集"><option value="">全部</option>{rizlineOptions.trackSeries.map((value) => <option value={value}>{value}</option>)}</select></label>
    </div>
  ) : data.game === "infalsus" && infalsusOptions ? (
    <div class="gallery-filter-row" data-gallery-filter-row>
      <label class="filter-control"><span>谱面难度</span><select data-browse-filter-select="chart" aria-label="谱面难度"><option value="">全部</option>{infalsusOptions.charts.map((value) => <option value={value}>{value}</option>)}</select></label>
    </div>
  ) : null}

  <div class="active-filter-row" data-browse-active hidden>
    <span class="active-filter-label">当前筛选</span>
    <div class="active-filter-chips" data-browse-active-chips></div>
    <button class="text-link" type="button" data-gallery-reset>清除全部</button>
  </div>

  <div class="gallery-grid" data-gallery-grid>
    {initialItems.map((item, index) => <BrowseCard item={item} selectable eager={index < 6} />)}
  </div>
  <div class="gallery-empty" data-browse-empty hidden>
    <p>没有找到符合条件的资源</p>
    <button class="button button-secondary" type="button" data-browse-empty-reset>清除全部</button>
  </div>

  <div class="gallery-more">
    <button class="button button-secondary" type="button" data-load-more hidden={initialItems.length >= data.items.length}>加载更多</button>
  </div>

  <div class="batch-bar" data-batch-bar hidden>
    <div>
      <strong data-batch-count>已选择 0 项</strong>
      <span data-batch-status aria-live="polite"></span>
    </div>
    <div class="batch-actions">
      <button class="button button-secondary" type="button" data-batch-download="original">下载原图</button>
      <button class="button button-primary" type="button" data-batch-download="upscaled">优先超分版</button>
    </div>
  </div>
</section>

<script src="../scripts/browse-gallery.ts"></script>
