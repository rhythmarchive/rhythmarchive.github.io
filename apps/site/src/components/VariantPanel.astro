---
import type { PublicDownload, PublicVariant } from "../lib/types";

interface Props {
  variant: PublicVariant;
  fallback?: PublicDownload | undefined;
  active?: boolean;
  alt?: string;
  sourceToggle?: boolean;
}

const { variant, fallback, active = false, alt = "资源预览", sourceToggle = false } = Astro.props;
const large = variant.preview.large ?? variant.preview.medium ?? variant.preview.small;
const srcset = [variant.preview.medium ? variant.preview.medium.url + " 640w" : "", variant.preview.large ? variant.preview.large.url + " 1280w" : ""].filter(Boolean).join(", ");
const useOriginalSource = sourceToggle && Boolean(variant.original);
const canToggleSource = useOriginalSource && Boolean(variant.upscaled);
---

<section class="variant-panel" data-variant-panel={variant.variantId} hidden={!active}>
  {useOriginalSource ? (
    <>
      {canToggleSource ? (
        <div class="variant-tabs detail-source-tabs" role="tablist" aria-label="预览版本">
          <button type="button" class="is-active" data-detail-source-select="original" role="tab" aria-selected="true">原图</button>
          <button type="button" data-detail-source-select="upscaled" role="tab" aria-selected="false">超分版</button>
        </div>
      ) : null}
      <div class="detail-source-panels">
        <div class="detail-source-panel" data-detail-source-panel="original">
          <div class="detail-preview-frame">
            <button class="detail-preview-trigger" type="button" data-lightbox-open data-lightbox-preview-url={variant.original!.url} data-lightbox-preview-width={variant.original!.width} data-lightbox-preview-height={variant.original!.height} data-lightbox-preview-alt={alt} aria-label={"点击查看" + alt + "原图"}>
              <img data-detail-image data-fallback-src={large?.url ?? fallback?.url} data-fallback-width={large?.width ?? fallback?.width} data-fallback-height={large?.height ?? fallback?.height} src={variant.original!.url} sizes="(max-width: 760px) 100vw, 66vw" alt={alt} width={variant.original!.width} height={variant.original!.height} loading={active ? "eager" : "lazy"} decoding="async" />
              <span class="detail-preview-hint">点击查看大图</span>
            </button>
          </div>
        </div>
        {canToggleSource ? (
          <div class="detail-source-panel" data-detail-source-panel="upscaled" hidden>
            <div class="detail-preview-frame">
              <button class="detail-preview-trigger" type="button" data-lightbox-open data-lightbox-preview-url={variant.upscaled!.url} data-lightbox-preview-width={variant.upscaled!.width} data-lightbox-preview-height={variant.upscaled!.height} data-lightbox-preview-alt={alt} aria-label={"点击查看" + alt + "超分版大图"}>
                <img data-detail-image data-fallback-src={variant.original!.url} data-fallback-width={variant.original!.width} data-fallback-height={variant.original!.height} src={variant.upscaled!.url} sizes="(max-width: 760px) 100vw, 66vw" alt={alt} width={variant.upscaled!.width} height={variant.upscaled!.height} loading="lazy" decoding="async" />
                <span class="detail-preview-hint">点击查看大图</span>
              </button>
            </div>
          </div>
        ) : null}
      </div>
    </>
  ) : (
    <div class="detail-preview-frame">
      {large ? (
        <button class="detail-preview-trigger" type="button" data-lightbox-open data-lightbox-preview-url={large.url} data-lightbox-preview-width={large.width} data-lightbox-preview-height={large.height} data-lightbox-preview-alt={alt} aria-label={"点击查看" + alt + "大图"}>
          <img
            data-detail-image
            data-fallback-src={fallback?.url}
            data-fallback-width={fallback?.width}
            data-fallback-height={fallback?.height}
            src={large.url}
            srcset={srcset || undefined}
            sizes="(max-width: 760px) 100vw, 66vw"
            alt={alt}
            width={large.width}
            height={large.height}
            loading={active ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="detail-preview-hint">点击查看大图</span>
        </button>
      ) : <div class="resource-card-placeholder">图片暂不可用</div>}
    </div>
  )}
</section>
