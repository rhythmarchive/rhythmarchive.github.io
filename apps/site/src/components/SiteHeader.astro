---
import BrandMark from "./BrandMark.astro";
import { formatCount } from "../lib/format";
import { getPublicNavigationGames } from "../lib/site-data";
import { primaryCategorySlug } from "../lib/game-config";
import { urls } from "../lib/site-urls";

const games = getPublicNavigationGames();
const normalizePath = (pathname: string): string => {
  const normalized = pathname.replace(/\/+$/u, "");
  return normalized || "/";
};
const currentPath = normalizePath(Astro.url.pathname);
const isWithin = (pathname: string): boolean => {
  const target = normalizePath(pathname);
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
const isHome = currentPath === normalizePath(urls.sitePath("/"));
const isSearch = isWithin(urls.sitePath("/search/"));
const isUpdates = isWithin(urls.sitePath("/updates/"));
const isFeedback = isWithin(urls.sitePath("/feedback/"));
const isLibrary = isWithin(urls.sitePath("/library/"));
const isGameLibrary = isWithin(urls.sitePath("/games/"))
  || isWithin(urls.sitePath("/r/"))
  || games.some((game) => isWithin(urls.sitePath(`/${game.slug}/`)));
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-brand">
      <BrandMark />
    </div>
    <nav class="site-nav" id="site-primary-nav" aria-label="主要导航" data-mobile-open="false">
      <a class:list={{ "is-active": isHome }} href={urls.sitePath("/")} aria-current={isHome ? "page" : undefined}>首页</a>
      <details class:list={{ "nav-game-library": true, "is-active": isGameLibrary }}>
        <summary class:list={{ "nav-library-trigger": true, "is-active": isGameLibrary }}>游戏库<span class="nav-library-chevron" aria-hidden="true">⌄</span></summary>
        <div class="nav-library-popover">
          <div class="nav-library-heading">
            <strong>游戏库</strong>
            <a href={urls.sitePath("/games/")}>查看全部游戏</a>
          </div>
          <div class="nav-game-list">
            {games.map((game) => (
              <a href={urls.sitePath(`/${game.slug}/${primaryCategorySlug(game.slug)}/`)}>
                <span>{game.displayName}</span>
                <small>{formatCount(game.count)} 项</small>
              </a>
            ))}
          </div>
        </div>
      </details>
      <a class:list={{ "nav-resources": true, "is-active": isSearch }} href={urls.sitePath("/search/")} aria-current={isSearch ? "page" : undefined}>资源库</a>
      <a class:list={{ "nav-updates": true, "is-active": isUpdates }} href={urls.sitePath("/updates/")} aria-current={isUpdates ? "page" : undefined}>更新</a>
      <a class:list={{ "is-active": isLibrary }} href={urls.sitePath("/library/")} aria-current={isLibrary ? "page" : undefined}>收藏与历史</a>
      <a class:list={{ "nav-feedback": true, "is-active": isFeedback }} href={urls.sitePath("/feedback/")} aria-current={isFeedback ? "page" : undefined}>反馈</a>
    </nav>
    <div class="site-header-actions">
      <a class="nav-search" href={urls.sitePath("/search/")} aria-label="搜索资源">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="当前为跟随系统主题，下次切换为浅色主题" title="当前为跟随系统主题，点击切换为浅色主题">
        <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
        <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
      </button>
      <button class="site-menu-toggle" type="button" data-menu-toggle aria-controls="site-primary-nav" aria-expanded="false" aria-label="打开导航菜单">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>

<noscript>
  <nav class="site-noscript-nav" aria-label="导航链接">
    <a href={urls.sitePath("/")}>首页</a>
    <a href={urls.sitePath("/games/")}>游戏库</a>
    <a href={urls.sitePath("/search/")}>资源库</a>
    <a href={urls.sitePath("/updates/")}>更新</a>
    <a href={urls.sitePath("/library/")}>收藏与历史</a>
    <a href={urls.sitePath("/feedback/")}>反馈</a>
  </nav>
</noscript>

<script is:inline>
  (() => {
    const key = "rhythm-archive-theme";
    const root = document.documentElement;
    const valid = new Set(["system", "light", "dark"]);
    const descriptions = {
      system: ["跟随系统", "浅色"],
      light: ["浅色", "深色"],
      dark: ["深色", "跟随系统"],
    };
    const read = () => {
      try { return localStorage.getItem(key) || "system"; } catch { return "system"; }
    };
    const apply = (value) => {
      const theme = valid.has(value) ? value : "system";
      root.dataset.theme = theme;
      root.style.colorScheme = theme === "system" ? "light dark" : theme;
      const toggle = document.querySelector("[data-theme-toggle]");
      if (toggle) {
        const [current, next] = descriptions[theme];
        toggle.setAttribute("data-theme-value", theme);
        toggle.setAttribute("aria-label", `当前为${current}主题，下次切换为${next}主题`);
        toggle.setAttribute("title", `当前为${current}主题，点击切换为${next}主题`);
      }
      window.dispatchEvent(new CustomEvent("rhythm-theme-change", { detail: theme }));
    };
    apply(read());
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const current = root.dataset.theme || "system";
      const next = current === "system" ? "light" : current === "light" ? "dark" : "system";
      try { localStorage.setItem(key, next); } catch { /* theme still applies for this session */ }
      apply(next);
    });
  })();
</script>

<script is:inline>
  (() => {
    const nav = document.querySelector("#site-primary-nav");
    const toggle = document.querySelector("[data-menu-toggle]");
    if (!nav || !toggle) return;
    const mobile = matchMedia("(max-width: 760px)");
    document.documentElement.classList.add("has-js");
    const setOpen = (open) => {
      nav.dataset.mobileOpen = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
      if (!open) nav.querySelector(".nav-game-library")?.removeAttribute("open");
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(open);
      if (open) nav.querySelector("a")?.focus();
    });
    nav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
    });
    document.addEventListener("pointerdown", (event) => {
      if (mobile.matches && !nav.contains(event.target) && !toggle.contains(event.target)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    mobile.addEventListener("change", () => setOpen(false));
  })();
</script>
