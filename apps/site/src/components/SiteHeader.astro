---
import BrandMark from "./BrandMark.astro";
import { formatCount } from "../lib/format";
import { getPublicNavigationGames } from "../lib/site-data";
import { primaryCategorySlug } from "../lib/game-config";
import { urls } from "../lib/site-urls";

const games = getPublicNavigationGames();
const normalizePath = (pathname: string): string => {
  const normalized = pathname.replace(/\/+$/u, "");
  return normalized || "/";
};
const currentPath = normalizePath(Astro.url.pathname);
const isWithin = (pathname: string): boolean => {
  const target = normalizePath(pathname);
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
const isHome = currentPath === normalizePath(urls.sitePath("/"));
const isSearch = isWithin(urls.sitePath("/search/"));
const isUpdates = isWithin(urls.sitePath("/updates/"));
const isFeedback = isWithin(urls.sitePath("/feedback/"));
const isLibrary = isWithin(urls.sitePath("/library/"));
const isGameLibrary = isWithin(urls.sitePath("/games/"))
  || isWithin(urls.sitePath("/r/"))
  || games.some((game) => isWithin(urls.sitePath(`/${game.slug}/`)));
---

<header class="site-header" transition:persist="site-header" transition:name="site-header">
  <div class="site-header-inner">
    <div class="site-header-brand">
      <BrandMark />
    </div>
    <nav class="site-nav" id="site-primary-nav" aria-label="主要导航" data-mobile-open="false">
      <a class:list={{ "is-active": isHome }} href={urls.sitePath("/")} aria-current={isHome ? "page" : undefined}>首页</a>
      <details class:list={{ "nav-game-library": true, "is-active": isGameLibrary }}>
        <summary class:list={{ "nav-library-trigger": true, "is-active": isGameLibrary }} aria-controls="nav-game-links">游戏库<span class="nav-library-chevron" aria-hidden="true">⌄</span></summary>
        <div class="nav-library-popover" id="nav-game-links">
          <div class="nav-library-heading">
            <a href={urls.sitePath("/games/")}>查看全部游戏</a>
          </div>
          <div class="nav-game-list">
            {games.map((game) => (
              <a href={urls.sitePath(`/${game.slug}/${primaryCategorySlug(game.slug)}/`)}>
                <span>{game.displayName}</span>
                <small>{formatCount(game.count)} 项</small>
              </a>
            ))}
          </div>
        </div>
      </details>
      <a class:list={{ "nav-resources": true, "is-active": isSearch }} href={urls.sitePath("/search/")} aria-current={isSearch ? "page" : undefined}>资源库</a>
      <a class:list={{ "nav-updates": true, "is-active": isUpdates }} href={urls.sitePath("/updates/")} aria-current={isUpdates ? "page" : undefined}>更新</a>
      <a class:list={{ "is-active": isLibrary }} href={urls.sitePath("/library/")} aria-current={isLibrary ? "page" : undefined}>收藏与历史</a>
      <a class:list={{ "nav-feedback": true, "is-active": isFeedback }} href={urls.sitePath("/feedback/")} aria-current={isFeedback ? "page" : undefined}>反馈</a>
    </nav>
    <div class="site-header-actions">
      <a class="nav-search header-icon-button" href={urls.sitePath("/search/")} aria-label="搜索资源" title="搜索资源（快捷键 /）" aria-keyshortcuts="/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.5 4.5"/></svg>
      </a>
      <div class="site-settings">
        <button class="settings-toggle header-icon-button" type="button" data-settings-toggle aria-haspopup="dialog" aria-controls="site-settings-panel" aria-expanded="false" aria-label="显示设置" title="显示设置">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h8.5M17.5 7.5H20M4 16.5h2.5M11.5 16.5H20"/><circle cx="15" cy="7.5" r="2.4"/><circle cx="9" cy="16.5" r="2.4"/></svg>
        </button>
        <div class="settings-panel" id="site-settings-panel" role="dialog" aria-labelledby="site-settings-title" data-settings-panel hidden>
          <div class="settings-panel-heading">
            <strong id="site-settings-title">显示设置</strong>
            <span>仅保存在当前浏览器</span>
          </div>
          <fieldset class="settings-group">
            <legend>主题</legend>
            <div class="segmented" style="--segments: 3">
              <span class="segmented-thumb" aria-hidden="true"></span>
              <label><input type="radio" name="site-theme" value="system" data-theme-option checked /><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg><span>跟随系统</span></label>
              <label><input type="radio" name="site-theme" value="light" data-theme-option /><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.5 12h2M19.5 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span>浅色</span></label>
              <label><input type="radio" name="site-theme" value="dark" data-theme-option /><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg><span>深色</span></label>
            </div>
          </fieldset>
          <fieldset class="settings-group">
            <legend>动效</legend>
            <div class="segmented" style="--segments: 4">
              <span class="segmented-thumb" aria-hidden="true"></span>
              <label><input type="radio" name="site-motion" value="system" data-motion-option checked /><span>跟随系统</span></label>
              <label><input type="radio" name="site-motion" value="reduced" data-motion-option /><span>精简</span></label>
              <label><input type="radio" name="site-motion" value="standard" data-motion-option /><span>标准</span></label>
              <label><input type="radio" name="site-motion" value="rich" data-motion-option /><span>丰富</span></label>
            </div>
            <p class="settings-hint" data-motion-hint></p>
          </fieldset>
        </div>
      </div>
      <button class="site-menu-toggle" type="button" data-menu-toggle aria-controls="site-primary-nav" aria-expanded="false" aria-label="打开导航菜单">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>

<noscript>
  <nav class="site-noscript-nav" aria-label="导航链接">
    <a href={urls.sitePath("/")}>首页</a>
    <a href={urls.sitePath("/games/")}>游戏库</a>
    <a href={urls.sitePath("/search/")}>资源库</a>
    <a href={urls.sitePath("/updates/")}>更新</a>
    <a href={urls.sitePath("/library/")}>收藏与历史</a>
    <a href={urls.sitePath("/feedback/")}>反馈</a>
  </nav>
</noscript>

<script src="../scripts/site-header.ts"></script>
