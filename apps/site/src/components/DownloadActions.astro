---
import type { PublicVariant } from "../lib/types";
import { formatBytes } from "../lib/format";

interface Props {
  variant: PublicVariant;
  active?: boolean;
}

const { variant, active = true } = Astro.props;
const originals = variant.originals ?? (variant.original ? [variant.original] : []);
---

<div class="download-panel" data-download-panel data-download-variant={variant.variantId} hidden={!active}>
  <div class="download-panel-heading">
    <span class="section-kicker">下载</span>
    <span data-download-status aria-live="polite"></span>
  </div>
  <div class="download-actions">
    {originals.map((original, index) => (
      <button class="download-button" type="button" data-download-kind="original" data-download-url={original.url} data-download-filename={original.downloadFilename}>
        <span>{originals.length > 1 ? "原图 " + (index + 1) : "原图"}</span><small>{formatBytes(original.sizeBytes)}</small>
      </button>
    ))}
    {variant.upscaled ? (
      <button class="download-button" type="button" data-download-kind="upscaled" data-download-url={variant.upscaled.url} data-download-filename={variant.upscaled.downloadFilename}>
        <span>超分版 <em class="download-recommend">推荐</em></span><small>{formatBytes(variant.upscaled.sizeBytes)}</small>
      </button>
    ) : null}
  </div>
</div>
