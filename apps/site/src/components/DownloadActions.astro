---
import type { PublicVariant } from "../lib/types";
import { formatBytes, formatImageDimensions } from "../lib/format";

interface Props {
  variant: PublicVariant;
  active?: boolean;
}

const { variant, active = true } = Astro.props;
const originals = variant.originals ?? (variant.original ? [variant.original] : []);
const originalOptions = originals.map((original, index) => ({ original, index, dimensions: formatImageDimensions(original.width, original.height) }));
const upscaled = variant.upscaled;
const upscaledDimensions = upscaled ? formatImageDimensions(upscaled.width, upscaled.height) : undefined;
---

<div class="download-panel" data-download-panel data-download-variant={variant.variantId} hidden={!active}>
  <div class="download-panel-heading">
    <span class="section-kicker">下载</span>
    <span data-download-status aria-live="polite"></span>
  </div>
  <div class="download-actions">
    {originalOptions.map(({ original, index, dimensions }) => (
      <button class="download-button" type="button" data-download-kind="original" data-download-url={original.url} data-download-filename={original.downloadFilename}>
        <span>{originals.length > 1 ? "原图 " + (index + 1) : "原图"}{dimensions ? <em class="download-dimensions">{dimensions}</em> : null}</span><small>{formatBytes(original.sizeBytes)}</small>
      </button>
    ))}
    {upscaled ? (
      <button class="download-button" type="button" data-download-kind="upscaled" data-download-url={upscaled.url} data-download-filename={upscaled.downloadFilename}>
        <span>超分版{upscaledDimensions ? <em class="download-dimensions">{upscaledDimensions}</em> : null}</span><small>{formatBytes(upscaled.sizeBytes)}</small>
      </button>
    ) : null}
  </div>
</div>
