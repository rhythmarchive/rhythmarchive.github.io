---
import CardShell from "./CardShell.astro";
import { publicResourceCardView } from "../lib/card-view-model";
import type { PublicResource } from "../lib/types";

interface Props {
  resource: PublicResource;
  index?: number;
  selectable?: boolean;
  eager?: boolean;
}

const { resource, selectable = false, eager = false } = Astro.props;
const view = publicResourceCardView(resource);
---

<CardShell view={view} selectable={selectable} eager={eager} />