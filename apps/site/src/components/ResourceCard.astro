---
import type { PublicResource } from "../lib/types";
import { BASE_PATH } from "../lib/site-config";
import { createUrlHelpers } from "../lib/url";
import { cardMediaFit, cardMediaRatio } from "../lib/media-config";

interface Props {
  resource: PublicResource;
  index?: number;
  selectable?: boolean;
  eager?: boolean;
}

const { resource, selectable = false, eager = false } = Astro.props;
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: "https://rhythmarchive.github.io", rosBaseUrl: "https://rhythm-assets.cn-nb1.rains3.com" });
const small = resource.preview.small ?? resource.preview.medium ?? resource.preview.large;
const srcset = [resource.preview.small ? `${resource.preview.small.url} 320w` : "", resource.preview.medium ? `${resource.preview.medium.url} 640w` : ""].filter(Boolean).join(", ");
const variantLabel = resource.variants.find((variant) => variant.label !== "默认")?.label;
---

<article class="resource-card" data-resource-card data-resource-id={resource.resourceId} data-game={resource.game} data-resource-type={resource.resourceType} data-media-ratio={cardMediaRatio(resource.game, resource.resourceType)} data-media-fit={cardMediaFit(resource.game, resource.resourceType)}>
  {selectable ? (
    <button class="resource-select" type="button" data-select-resource={resource.resourceId} aria-pressed="false" aria-label={`选择 ${resource.displayTitle}`}>
      <span aria-hidden="true">✓</span>
    </button>
  ) : null}
  <a class="resource-card-link" href={urls.sitePath(resource.route)}>
    <div class="resource-card-media">
      {small ? (
        <img
          src={small.url}
          srcset={srcset || undefined}
          sizes="(max-width: 640px) 50vw, (max-width: 1280px) 20vw, 210px"
          alt={resource.displayTitle}
          width={small.width}
          height={small.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
        />
      ) : <div class="resource-card-placeholder" aria-label="图片加载失败">图片暂不可用</div>}
      {resource.upscaled ? <span class="resource-badge is-upscaled">含超分版</span> : null}
    </div>
    <div class="resource-card-body">
      <h3>{resource.displayTitle}</h3>
      {resource.artist ? <p>{resource.artist}</p> : null}
      {resource.subtitle ? <p class="resource-card-subtitle">{resource.subtitle}</p> : null}
      {(resource.badges ?? []).map((badge) => <span class="resource-card-variant">{badge}</span>)}
      {resource.badges?.length ? null : (variantLabel ? <span class="resource-card-variant">{variantLabel}</span> : null)}
    </div>
  </a>
</article>
