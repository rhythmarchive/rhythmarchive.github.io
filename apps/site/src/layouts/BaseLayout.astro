---
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { BASE_PATH, PUBLIC_STATS_API_URL, ROS_BASE_URL, SITE_ORIGIN } from "../lib/site-config";
import { createUrlHelpers } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string | undefined;
  bodyClass?: string;
}

const { title, description, canonicalPath, ogImage, bodyClass = "" } = Astro.props;
const urls = createUrlHelpers({ basePath: BASE_PATH, origin: SITE_ORIGIN, rosBaseUrl: ROS_BASE_URL });
const canonical = urls.absoluteUrl(canonicalPath);
const socialImage = ogImage ?? urls.absoluteUrl("/brand-mark.svg");
const rosOrigin = new URL(ROS_BASE_URL).origin;
---

<!doctype html>
<html lang="zh-CN" data-theme="system" data-base-path={BASE_PATH} data-stats-api-url={PUBLIC_STATS_API_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2d77d9" />
    <link rel="icon" type="image/svg+xml" href={urls.sitePath("/favicon.svg")} />
    <link rel="manifest" href={urls.sitePath("/site.webmanifest")} />
    <link rel="preconnect" href={rosOrigin} crossorigin="anonymous" />
    <link rel="dns-prefetch" href={rosOrigin} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rhythm Archive" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("rhythm-archive-theme");
          if (saved === "light" || saved === "dark" || saved === "system") document.documentElement.dataset.theme = saved;
        } catch { /* system theme remains the default */ }
      })();
    </script>
    <script is:inline>
      document.addEventListener("error", (event) => {
        const image = event.target;
        if (!(image instanceof HTMLImageElement)) return;
        const fallback = image.dataset.fallbackSrc;
        if (!fallback || image.dataset.fallbackApplied === "true") return;
        image.dataset.fallbackApplied = "true";
        image.removeAttribute("srcset");
        image.src = fallback;
        const lightboxTrigger = image.closest("[data-lightbox-open]");
        if (lightboxTrigger instanceof HTMLElement) {
          lightboxTrigger.dataset.lightboxPreviewUrl = fallback;
          if (image.dataset.fallbackWidth) lightboxTrigger.dataset.lightboxPreviewWidth = image.dataset.fallbackWidth;
          if (image.dataset.fallbackHeight) lightboxTrigger.dataset.lightboxPreviewHeight = image.dataset.fallbackHeight;
        }
      }, true);
    </script>
    <script src="../scripts/stats.ts"></script>
  </head>
  <body class={bodyClass}>
    <SiteHeader />
    <main class="site-main"><slot /></main>
    <Footer />
  </body>
</html>
