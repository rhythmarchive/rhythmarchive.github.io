---
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { ClientRouter } from "astro:transitions";
import { BASE_PATH, PUBLIC_STATS_API_URL, ROS_BASE_URL } from "../lib/site-config";
import { urls } from "../lib/site-urls";
import "../styles/global.css";
import "../styles/story-atlas.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string | undefined;
  bodyClass?: string;
}

const { title, description, canonicalPath, ogImage, bodyClass = "" } = Astro.props;

const canonical = urls.absoluteUrl(canonicalPath);
const socialImage = ogImage ?? urls.absoluteUrl("/brand-mark.svg");
const rosOrigin = new URL(ROS_BASE_URL).origin;
---

<!doctype html>
<html lang="zh-CN" data-theme="system" data-base-path={BASE_PATH} data-stats-api-url={PUBLIC_STATS_API_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <noscript><style is:inline>img[data-viewport-src] { display: none; }</style></noscript>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2d77d9" />
    <link rel="icon" type="image/svg+xml" href={urls.sitePath("/favicon.svg")} />
    <link rel="manifest" href={urls.sitePath("/site.webmanifest")} />
    <link rel="preconnect" href={rosOrigin} crossorigin="anonymous" />
    <link rel="dns-prefetch" href={rosOrigin} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rhythm Archive" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script is:inline data-astro-rerun>
      (() => {
        document.documentElement.classList.add("has-gallery-js");
        try {
          const saved = localStorage.getItem("rhythm-archive-theme");
          if (saved === "light" || saved === "dark" || saved === "system") document.documentElement.dataset.theme = saved;
        } catch { /* system theme remains the default */ }
      })();
    </script>
    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/stats.ts"></script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main class="site-main" id="main-content" tabindex="-1" transition:name="main-content"><slot /></main>
    <Footer />
  </body>
</html>
