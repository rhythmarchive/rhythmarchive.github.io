# Dependencies and package-manager caches
node_modules/
.npm-cache/
.pnpm-store/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local runtime/workspace data and generated processing outputs
.runtime/
apk/
docs/apk-audit.zip
dist/
build/
coverage/
test-results/
temp/
playwright-report/
.playwright-cli/
output/

# Astro public projection generated from the frozen formal Catalog
apps/site/.astro/
apps/site/src/generated/
apps/site/public/data/

# Local configuration and secrets
.env
.env.*
.dev.vars
.dev.vars.*
*.local
*.pem
*.key

# Logs and temporary files
*.log
*.tmp
*.temp
*.partial-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local public-site development skills; private resource-production skills live in Tooling.
.agents/
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/update-timeline/
!.agents/skills/update-timeline/SKILL.md

# Stats Worker local state. Source, configuration, migrations and tests are public.
workers/stats/.wrangler/
workers/stats/.dev.vars
workers/stats/*.dev.vars
workers/stats/*.log
