# Dependencies and package-manager caches
node_modules/
.npm-cache/
.pnpm-store/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local runtime/workspace data and generated processing outputs
.runtime/
apk/
docs/apk-audit.zip
dist/
build/
coverage/
test-results/
temp/
playwright-report/
.playwright-cli/

# Astro public projection generated from the frozen formal Catalog
apps/site/.astro/
apps/site/src/generated/
apps/site/public/data/
workers/stats/.wrangler/

# Local configuration and secrets
.env
.env.*
*.local
*.pem
*.key

# Logs and temporary files
*.log
*.tmp
*.temp
*.partial-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local archive for superseded, non-runtime material; contents may be deleted.
lagacy/
