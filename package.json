{
  "name": "rhythm-assets-gallery-v2",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "tsx --test packages/domain/tests/*.test.ts packages/admin/tests/*.test.ts apps/site/tests/*.test.ts",
    "admin": "node --env-file-if-exists=.env --import tsx packages/admin/src/server.ts",
    "rhythmctl": "node --env-file-if-exists=.env --import tsx tools/rhythmctl.ts",
    "typecheck": "tsc --noEmit",
    "site:dev": "tsx apps/site/scripts/generate-public-data.ts && astro dev --root apps/site",
    "site:check": "tsx apps/site/scripts/generate-public-data.ts && astro check --root apps/site",
    "site:build": "tsx apps/site/scripts/generate-public-data.ts && astro build --root apps/site",
    "site:preview": "astro preview --root apps/site",
    "site:smoke": "tsx apps/site/scripts/smoke.ts",
    "test:all": "npm run typecheck && npm test",
    "ci:check": "npm run test:all && npm run site:check && npm run site:build && npm run site:smoke && npm run browse:check",
    "experiment:upscale": "tsx tools/upscale-experiment.ts",
    "experiment:upscale:phase2b": "tsx tools/phase2b-upscale-experiment.ts",
    "test:phase2b": "tsx --test packages/domain/tests/phase2b.test.ts",
    "phase2b:workspace": "tsx tools/phase2b-workspace.ts",
    "phase2c:rehearsal": "tsx tools/phase2c-rehearsal.ts",
    "legacy:dry-run": "tsx tools/legacy-dry-run.ts",
    "legacy:migrate": "node --env-file-if-exists=.env --import tsx tools/legacy-migrate.ts",
    "legacy:check": "node --env-file-if-exists=.env --import tsx tools/legacy-consistency.ts",
    "ros:verify": "node --env-file-if-exists=.env --import tsx tools/ros-verify.ts",
    "arcaea:apk:check": "node --env-file-if-exists=.env --import tsx tools/arcaea-apk-update.ts",
    "arcaea:character-metadata": "node --env-file-if-exists=.env --import tsx tools/apply-arcaea-character-metadata.ts",
    "arcaea:story:audit": "tsx tools/arcaea-story-audit.ts --package-root temp/arcaea-story-atlas-investigation/package --index docs/apk-audit/data/arcaea-story-index.json --output docs/apk-audit/data --catalog catalog/index.json",
    "arcaea:story:derivatives": "tsx tools/arcaea-story-derivatives.ts --package-root temp/arcaea-story-atlas-investigation/package --index docs/apk-audit/data/arcaea-story-index.json --catalog catalog/index.json --output-root apps/site/public/generated/arcaea/story --manifest docs/apk-audit/data/arcaea-story-derivative-manifest.json",
    "browse:bootstrap": "tsx tools/browse-projection.ts --catalog catalog/index.json --output catalog/browse --bootstrap-audit docs/apk-audit/data --curation catalog/curation/arcaea-april-fools.json",
    "browse:check": "tsx tools/validate-browse-projection.ts --catalog catalog/index.json --output catalog/browse",
    "browse:semantic": "tsx tools/semantic-browse.ts --catalog catalog/index.json --audit docs/apk-audit/data --output catalog/browse"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/lib-storage": "^3.1110.0",
    "astro": "^6.3.1",
    "fflate": "^0.8.2",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
