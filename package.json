{
  "name": "rhythm-assets-gallery-v2",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "tsx --test apps/site/tests/site.test.ts apps/site/tests/browse-gallery.test.ts apps/site/tests/stats-client.test.ts apps/site/tests/update-history.test.ts apps/site/tests/update-reminder.test.ts apps/site/tests/batch.test.ts apps/site/tests/ranking.test.ts",
    "typecheck": "tsc -p apps/site/tsconfig.json --noEmit",
    "site:dev": "tsx apps/site/scripts/generate-public-data.ts && astro dev --root apps/site",
    "site:check": "tsx apps/site/scripts/generate-public-data.ts && astro check --root apps/site",
    "site:build": "tsx apps/site/scripts/generate-public-data.ts && astro build --root apps/site",
    "site:preview": "astro preview --root apps/site",
    "site:smoke": "tsx apps/site/scripts/smoke.ts",
    "traffic:check": "tsx apps/site/scripts/traffic-check.ts",
    "browse:check": "tsx tools/validate-browse-projection.ts",
    "stats:registry": "tsx apps/site/scripts/generate-stats-resource-registry.ts",
    "stats:registry:check": "tsx apps/site/scripts/generate-stats-resource-registry.ts --check",
    "worker:typecheck": "tsc -p workers/stats/tsconfig.json --noEmit",
    "worker:test": "tsx --test workers/stats/tests/*.test.ts",
    "worker:check": "npm run worker:typecheck && npm run worker:test",
    "test:all": "npm run typecheck && npm test",
    "ci:check": "npm run test:all && npm run stats:registry:check && npm run browse:check && npm run worker:check && npm run site:check && npm run site:build && npm run traffic:check && npm run site:smoke"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "7.3.3",
    "fflate": "^0.8.2",
    "sharp": "0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
